// This Pine Script(tm) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// Full Strategy Composite
//
// All top-performing strategies as independently toggleable modes.
// Walk-forward validated winners plus optimizer tournament leaders.
// DMI+VWAP, MACD+OBV, Momentum Confluence, BB+RSI, RSI, SMA.
//
// Modes: DMIVWAP, MACDOBV, MOM, BBRSI, RSI, SMA
// Aggregation: first_to_fire

//@version=6
indicator("Full Strategy Composite", shorttitle="FULL-COMP", overlay=true, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

bool   showLabels    = input.bool(true, title="Show Signal Labels", group="Display")
bool   showBgColor   = input.bool(true, title="Show Background Coloring", group="Display")

// --- DMI + VWAP ---
bool   enableDMIVWAP    = input.bool(true, title="Enable DMI + VWAP", group="DMI + VWAP")
int    dvDmiPeriod      = input.int(14, title="DMI Period", minval=1)
float  dvAdxThresh      = input.float(25.0, title="ADX Threshold", minval=0.0, step=0.5)

// --- MACD + OBV ---
bool   enableMACDOBV    = input.bool(true, title="Enable MACD + OBV", group="MACD + OBV")
int    moFast           = input.int(12, title="MACD Fast", minval=1)
int    moSlow           = input.int(26, title="MACD Slow", minval=1)
int    moSignal         = input.int(9, title="Signal Length", minval=1)
int    moObvSmooth      = input.int(5, title="OBV Smoothing", minval=1)

// --- Momentum Confluence ---
bool   enableMOM        = input.bool(true, title="Enable Momentum Confluence", group="Momentum Confluence")
int    mcFast           = input.int(12, title="Fast EMA", minval=1)
int    mcSlow           = input.int(26, title="Slow EMA", minval=1)
int    mcSignal         = input.int(9, title="Signal Period", minval=1)
int    mcTrendEma       = input.int(200, title="Trend EMA Period", minval=1)
float  mcAdxThresh      = input.float(25.0, title="ADX Threshold", minval=0.0, step=1.0)

// --- BB + RSI ---
bool   enableBBRSI      = input.bool(true, title="Enable BB + RSI", group="BB + RSI")
int    brBbPeriod       = input.int(20, title="BB Period", minval=1)
float  brBbMult         = input.float(2.0, title="BB Std Dev", minval=0.5, step=0.1)
int    brRsiPeriod      = input.int(14, title="RSI Period", minval=1)
float  brRsiOS          = input.float(30.0, title="RSI Oversold", minval=0.0, step=1.0)
float  brRsiOB          = input.float(70.0, title="RSI Overbought", minval=0.0, step=1.0)
float  brAdxMax         = input.float(25.0, title="ADX Max (ranging)", minval=0.0, step=1.0)

// --- RSI Strategy ---
bool   enableRSI        = input.bool(true, title="Enable RSI Strategy", group="RSI Strategy")
int    rsRsiPeriod      = input.int(14, title="RSI Period", minval=1)
float  rsOversold       = input.float(30.0, title="Oversold", minval=0.0, step=1.0)
float  rsOverbought     = input.float(70.0, title="Overbought", minval=0.0, step=1.0)

// --- SMA Crossover ---
bool   enableSMA        = input.bool(true, title="Enable SMA Crossover", group="SMA Crossover")
int    smFast           = input.int(10, title="Fast SMA Period", minval=1)
int    smSlow           = input.int(20, title="Slow SMA Period", minval=1)


// ─────────────────────────────────────────────────────────────────────────────
// SHARED INDICATORS
// ─────────────────────────────────────────────────────────────────────────────


// ─────────────────────────────────────────────────────────────────────────────
// MODE: DMI + VWAP
// ─────────────────────────────────────────────────────────────────────────────

// DMI crossover filtered by session VWAP.


// Session-Anchored VWAP
float tp = (high + low + close) / 3.0
var float cumTPV = 0.0
var float cumVol = 0.0

if isNewSession
    cumTPV := tp * volume
    cumVol := volume
else
    cumTPV += tp * volume
    cumVol += volume

float dvVwap = cumVol != 0 ? cumTPV / cumVol : close
plot(inSession ? dvVwap : na, title="VWAP", color=color.blue, linewidth=2)

[dvPlusDI, dvMinusDI, dvAdx] = ta.dmi(dvDmiPeriod, dvDmiPeriod)
bool dmivwapLong = enableDMIVWAP and (close > dvVwap and dvPlusDI > dvMinusDI and dvAdx > dvAdxThresh)
bool dmivwapShort = enableDMIVWAP and (close < dvVwap and dvMinusDI > dvPlusDI and dvAdx > dvAdxThresh)

// ─────────────────────────────────────────────────────────────────────────────
// MODE: MACD + OBV
// ─────────────────────────────────────────────────────────────────────────────

// MACD crossover confirmed by OBV trend.

[moMacdLine, moMacdSignal, moMacdHist] = ta.macd(close, moFast, moSlow, moSignal)
float moObvRaw = ta.obv
float moObvSmoothed = ta.ema(moObvRaw, moObvSmooth)
bool moObvRising = moObvSmoothed > moObvSmoothed[1]
bool moObvFalling = moObvSmoothed < moObvSmoothed[1]
bool macdobvLong = enableMACDOBV and (ta.crossover(moMacdLine, moMacdSignal) and moObvRising)
bool macdobvShort = enableMACDOBV and (ta.crossunder(moMacdLine, moMacdSignal) and moObvFalling)

// ─────────────────────────────────────────────────────────────────────────────
// MODE: MOMENTUM CONFLUENCE
// ─────────────────────────────────────────────────────────────────────────────

// MACD + ADX + EMA trend + OBV confluence.

[mcMacdLine, mcMacdSignal, mcMacdHist] = ta.macd(close, mcFast, mcSlow, mcSignal)
float mcEmaTrend = ta.ema(close, mcTrendEma)
[mcPlusDI, mcMinusDI, mcAdx] = ta.dmi(14, 14)
float mcObvRaw = ta.obv
float mcObvEma = ta.ema(mcObvRaw, 5)
bool mcObvUp = mcObvEma > mcObvEma[1]
bool momLong = enableMOM and (ta.crossover(mcMacdLine, mcMacdSignal) and mcAdx > mcAdxThresh and mcPlusDI > mcMinusDI and close > mcEmaTrend and mcObvUp)
bool momShort = enableMOM and (ta.crossunder(mcMacdLine, mcMacdSignal) and mcAdx > mcAdxThresh and mcMinusDI > mcPlusDI and close < mcEmaTrend)

// ─────────────────────────────────────────────────────────────────────────────
// MODE: BB + RSI
// ─────────────────────────────────────────────────────────────────────────────

// BB touch + RSI extremes in ranging market.

[brMid, brUpper, brLower] = ta.bb(close, brBbPeriod, brBbMult)
float brRsi = ta.rsi(close, brRsiPeriod)
[brPlusDI, brMinusDI, brAdx] = ta.dmi(14, 14)
bool bbrsiLong = enableBBRSI and ((close <= brLower or ta.crossover(brRsi, brRsiOS)) and brAdx < brAdxMax)
bool bbrsiShort = enableBBRSI and ((close >= brUpper or ta.crossunder(brRsi, brRsiOB)) and brAdx < brAdxMax)

// ─────────────────────────────────────────────────────────────────────────────
// MODE: RSI STRATEGY
// ─────────────────────────────────────────────────────────────────────────────

// RSI oversold/overbought crossover.

float rsRsi = ta.rsi(close, rsRsiPeriod)
bool rsiLong = enableRSI and (ta.crossover(rsRsi, rsOversold))
bool rsiShort = enableRSI and (ta.crossunder(rsRsi, rsOverbought))

// ─────────────────────────────────────────────────────────────────────────────
// MODE: SMA CROSSOVER
// ─────────────────────────────────────────────────────────────────────────────

// Golden/Death Cross SMA crossover.

float smFastSma = ta.sma(close, smFast)
float smSlowSma = ta.sma(close, smSlow)
bool smaLong = enableSMA and (ta.crossover(smFastSma, smSlowSma))
bool smaShort = false

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL AGGREGATION
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition = false
bool shortCondition = false
var string activeMode = ""

if macdobvLong
    longCondition := true
    activeMode := "MACDOBV"
else if dmivwapLong
    longCondition := true
    activeMode := "DMIVWAP"
else if momLong
    longCondition := true
    activeMode := "MOM"
else if bbrsiLong
    longCondition := true
    activeMode := "BBRSI"
else if rsiLong
    longCondition := true
    activeMode := "RSI"
else if smaLong
    longCondition := true
    activeMode := "SMA"

if macdobvShort
    shortCondition := true
    activeMode := "MACDOBV"
else if dmivwapShort
    shortCondition := true
    activeMode := "DMIVWAP"
else if momShort
    shortCondition := true
    activeMode := "MOM"
else if bbrsiShort
    shortCondition := true
    activeMode := "BBRSI"
else if rsiShort
    shortCondition := true
    activeMode := "RSI"
else if smaShort
    shortCondition := true
    activeMode := "SMA"

// Position state: +1 = long, -1 = short, 0 = flat
var int posState = 0

bool buySignal      = longCondition and posState != 1
bool sellSignal     = shortCondition and posState != -1
bool exitLongSignal  = posState == 1 and (shortCondition)
bool exitShortSignal = posState == -1 and (longCondition)

// Update position state
if buySignal
    posState := 1
else if sellSignal
    posState := -1
else if exitLongSignal or exitShortSignal
    posState := 0

// ─────────────────────────────────────────────────────────────────────────────
// LABELS
// ─────────────────────────────────────────────────────────────────────────────

if showLabels
    if buySignal
        label.new(bar_index, low, activeMode + " Buy",
             style=label.style_label_up,
             color=color.green,
             textcolor=color.white,
             size=size.small)
    if sellSignal
        label.new(bar_index, high, activeMode + " Sell",
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.small)
    if exitLongSignal
        label.new(bar_index, high, "Exit Long",
             style=label.style_label_down,
             color=color.orange,
             textcolor=color.white,
             size=size.small)
    if exitShortSignal
        label.new(bar_index, low, "Exit Short",
             style=label.style_label_up,
             color=color.orange,
             textcolor=color.white,
             size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if showBgColor
    if posState == 1
        bgColor := color.new(color.green, 90)
    else if posState == -1
        bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────

alertcondition(buySignal,
     title="Buy",
     message="Full Strategy Composite: Buy signal triggered.")
alertcondition(sellSignal,
     title="Sell",
     message="Full Strategy Composite: Sell signal triggered.")
alertcondition(exitLongSignal,
     title="Exit Long",
     message="Full Strategy Composite: Exit Long signal.")
alertcondition(exitShortSignal,
     title="Exit Short",
     message="Full Strategy Composite: Exit Short signal.")
alertcondition((dmivwapLong or dmivwapShort),
     title="DMI + VWAP Signal",
     message="Full Strategy Composite: DMI + VWAP signal triggered.")
alertcondition((macdobvLong or macdobvShort),
     title="MACD + OBV Signal",
     message="Full Strategy Composite: MACD + OBV signal triggered.")
alertcondition((momLong or momShort),
     title="Momentum Confluence Signal",
     message="Full Strategy Composite: Momentum Confluence signal triggered.")
alertcondition((bbrsiLong or bbrsiShort),
     title="BB + RSI Signal",
     message="Full Strategy Composite: BB + RSI signal triggered.")
alertcondition((rsiLong or rsiShort),
     title="RSI Strategy Signal",
     message="Full Strategy Composite: RSI Strategy signal triggered.")
alertcondition((smaLong or smaShort),
     title="SMA Crossover Signal",
     message="Full Strategy Composite: SMA Crossover signal triggered.")
alertcondition((buySignal or sellSignal or exitLongSignal or exitShortSignal),
     title="Any Signal",
     message="Full Strategy Composite: Signal triggered. Check chart.")
