// This Pine Script(tm) v6 strategy is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// VWAP Composite Strategy
//
// Comprehensive VWAP intraday strategy with 5 entry modes.
// Each mode can be independently enabled/disabled.
// Modes: PB (Pullback), REV (Reversal), ORB (OR Breakout),
// ORR (OR Reversal), PS (Pattern Scalp).
// Default aggregation: first-to-fire with priority ordering.
//
// Modes: PS, ORB, ORR, PB, REV
// Aggregation: first_to_fire

//@version=6
strategy("VWAP Composite Strategy", shorttitle="VWAP-ALL", overlay=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=1.0,
     slippage=1, process_orders_on_close=false, calc_on_every_tick=false,
     margin_long=100, margin_short=100)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────


// --- Shared ---
int    atrLen           = input.int(14, title="ATR Length", minval=1)
int    adxLen           = input.int(14, title="ADX Length", minval=1)
int    emaFastLen       = input.int(9, title="EMA Fast", minval=1)
int    emaSlowLen       = input.int(21, title="EMA Slow", minval=1)

// --- Pattern Scalp ---
bool   enablePS         = input.bool(false, title="Enable Pattern Scalp", group="Pattern Scalp")
float  psAtrPct         = input.float(30.0, title="Min OR as % of ATR", minval=10.0, step=5.0)
int    psWindow         = input.int(12, title="Max Bar for PS", minval=1)
float  psRvol           = input.float(1.0, title="Min RVOL", minval=0.5, step=0.5)

// --- OR Breakout ---
bool   enableORB        = input.bool(true, title="Enable OR Breakout", group="OR Breakout")
int    orbWindow        = input.int(20, title="Max Bar for ORB", minval=1)
float  orbRvol          = input.float(2.0, title="Min RVOL", minval=1.0, step=0.5)
float  orbBodyMin       = input.float(0.2, title="Min Body (x ATR)", minval=0.0, step=0.05)
string orbEntryMode     = input.string("aggressive", title="Entry Mode")
string orbSlMode        = input.string("OR Opposite", title="SL Mode")
string orbTpMode        = input.string("trail_only", title="TP Mode")
bool   orbReentryExit   = input.bool(false, title="Exit on OR Re-entry")
bool   orbGapFilter     = input.bool(false, title="Gap Alignment Filter")
bool   orbAdxFilter     = input.bool(false, title="ADX Regime Filter")
int    orbTimeExit      = input.int(0, title="Time Exit Bar (0=off)", minval=1)

// --- OR Reversal ---
bool   enableORR        = input.bool(true, title="Enable OR Reversal", group="OR Reversal")
int    orrWindow        = input.int(25, title="Max Bar for ORR", minval=1)
float  orrProx          = input.float(0.2, title="OR Proximity (x ATR)", minval=0.0, step=0.05)
float  orrRvol          = input.float(1.0, title="Min RVOL", minval=0.5, step=0.5)
string orrTpMode        = input.string("VWAP", title="TP Mode")
bool   orrVwapDisagree  = input.bool(false, title="VWAP Disagreement Filter")
bool   orrGapFilter     = input.bool(false, title="Gap Fade Filter")
bool   orrAdxFilter     = input.bool(false, title="Low-ADX Regime Filter")
bool   orrRebreakExit   = input.bool(false, title="Re-breakout Exit")
bool   orrRequireBreak  = input.bool(false, title="Require Breakout+Reclaim")

// --- Pullback ---
bool   enablePB         = input.bool(true, title="Enable VWAP Pullback", group="Pullback")
float  pbZone           = input.float(0.5, title="Zone Width (x band)", minval=0.1, step=0.1)
float  pbAdxMin         = input.float(21.0, title="Min ADX", minval=0.0, step=1.0)
int    pbTrendBars      = input.int(3, title="Trend Confirmation Bars", minval=1)
bool   pbVwapBias       = input.bool(false, title="VWAP Session Bias Filter")
float  pbVwapBiasPct    = input.float(0.7, title="VWAP Bias Min %", minval=0.5, step=0.05)
bool   pbRequireSr      = input.bool(false, title="Require S/R Confluence")
string pbTpMode         = input.string("rr", title="TP Mode")

// --- Reversal ---
bool   enableREV        = input.bool(true, title="Enable VWAP Reversal", group="Reversal")
float  revAdxMax        = input.float(21.0, title="Max ADX (sideways)", minval=0.0, step=1.0)
float  revBandMult      = input.float(2.0, title="Band Sigma", minval=1.0, step=0.5)
float  revBody          = input.float(0.2, title="Min Body (x ATR)", minval=0.0, step=0.05)
int    revCanTradeBar   = input.int(0, title="Earliest REV Bar (0=shared)", minval=1)
int    revMinTouches    = input.int(0, title="Min Band Touches (0=off)", minval=1)
int    revHugLimit      = input.int(20, title="Hugging Limit", minval=1)
string revTpMode        = input.string("vwap", title="TP Mode")
float  revRr            = input.float(1.0, title="R:R Multiplier (rr mode)", minval=0.0, step=0.1)
bool   revRequireSr     = input.bool(false, title="Require S/R Confluence")


// ─────────────────────────────────────────────────────────────────────────────
// SESSION DETECTION
// ─────────────────────────────────────────────────────────────────────────────


string SESSION  = "0930-1600"
string TIMEZONE = "America/New_York"

bool inSession = not na(time(timeframe.period, SESSION, TIMEZONE))
bool isNewSession = inSession and not inSession[1]

// ─────────────────────────────────────────────────────────────────────────────
// SHARED INDICATORS
// ─────────────────────────────────────────────────────────────────────────────


// Session-Anchored VWAP
float tp = (high + low + close) / 3.0
var float cumTPV = 0.0
var float cumVol = 0.0

if isNewSession
    cumTPV := tp * volume
    cumVol := volume
else
    cumTPV := cumTPV + tp * volume
    cumVol := cumVol + volume

float vwapValue = cumVol != 0 ? cumTPV / cumVol : close
plot(inSession ? vwapValue : na, title="VWAP", color=color.blue, linewidth=2)

float atrVal = ta.atr(atrLen)
plot(atrVal, title="ATR", color=color.new(color.gray, 100), display=display.data_window)
[plusDI, minusDI, adxValue] = ta.dmi(adxLen, adxLen)
float emaFast = ta.ema(close, emaFastLen)
plot(emaFast, title="EMA(emaFastLen)", color=color.teal, linewidth=1)
float emaSlow = ta.ema(close, emaSlowLen)
plot(emaSlow, title="EMA(emaSlowLen)", color=color.orange, linewidth=1)

// ─────────────────────────────────────────────────────────────────────────────
// SHARED COMPUTATIONS
// ─────────────────────────────────────────────────────────────────────────────

// --- Opening Range Tracking ---
int    orBars        = 3
var float orHigh     = na
var float orLow      = na
var bool  orDone     = false
var int   barOfDay   = 0

if isNewSession
    orHigh  := high
    orLow   := low
    orDone  := false
    barOfDay := 0

barOfDay += 1

if not orDone
    orHigh := math.max(orHigh, high)
    orLow  := math.min(orLow, low)
    if barOfDay >= orBars
        orDone := true

float orRange = orDone ? orHigh - orLow : na

// --- Candle Helpers ---
float bodySize = math.abs(close - open)
bool  bullCandle = close > open and bodySize >= atrVal * 0.15
bool  bearCandle = close < open and bodySize >= atrVal * 0.15

// --- VWAP Distance ---
float vwapDist = math.abs(close - vwapValue)

// --- Relative Volume ---
float avgVol20 = ta.sma(volume, 20)
float relVol   = avgVol20 > 0 ? volume / avgVol20 : 0

// ─────────────────────────────────────────────────────────────────────────────
// MODE: PATTERN SCALP
// ─────────────────────────────────────────────────────────────────────────────

// Fades opening range manipulation. Requires OR range ≥ daily ATR pct, then takes the opposite direction.

float dailyAtr = ta.atr(14)
bool isManip = orDone and orRange >= dailyAtr * psAtrPct / 100
bool orBullish = orDone and close[barOfDay] > open[barOfDay]
var bool psFiredToday = false
if isNewSession
    psFiredToday := false
bool psLong = enablePS and (isManip and not psFiredToday and barOfDay >= 4 and barOfDay <= psWindow and not orBullish and bullCandle and relVol >= psRvol)
bool psShort = enablePS and (isManip and not psFiredToday and barOfDay >= 4 and barOfDay <= psWindow and orBullish and bearCandle and relVol >= psRvol)

// ─────────────────────────────────────────────────────────────────────────────
// MODE: OR BREAKOUT
// ─────────────────────────────────────────────────────────────────────────────

// Momentum breakout beyond opening range with volume confirmation. Fire-once per session. Supports aggressive and retest entry modes, OR-range targets, gap/ADX filters.

var bool orbFiredToday = false
if isNewSession
    orbFiredToday := false
bool orbLong = enableORB and (orDone and not orbFiredToday and barOfDay <= orbWindow and close > orHigh and close > open and bodySize >= atrVal * orbBodyMin and relVol >= orbRvol and close > vwapValue)
bool orbShort = enableORB and (orDone and not orbFiredToday and barOfDay <= orbWindow and close < orLow and close < open and bodySize >= atrVal * orbBodyMin and relVol >= orbRvol and close < vwapValue)

// ─────────────────────────────────────────────────────────────────────────────
// MODE: OR REVERSAL
// ─────────────────────────────────────────────────────────────────────────────

// Fade opening range extreme on retest with reversal pattern. Supports VWAP disagreement filter, gap-fade context, low-ADX regime, breakout-then-reclaim, and OR-opposite targets. Fire-once per session.

var bool orrFiredToday = false
if isNewSession
    orrFiredToday := false

// Hammer: small body, long lower wick (bullish reversal)
float upperWick = high - math.max(open, close)
float lowerWick = math.min(open, close) - low
float candleRange = high - low
bool  isHammer = candleRange > 0 and lowerWick / candleRange >= 0.6 and bodySize / candleRange <= 0.3
bool  isInvHammer = candleRange > 0 and upperWick / candleRange >= 0.6 and bodySize / candleRange <= 0.3
bool orrLong = enableORR and (orDone and not orrFiredToday and barOfDay <= orrWindow and low <= orLow + atrVal * orrProx and (isHammer or bullCandle) and relVol >= orrRvol)
bool orrShort = enableORR and (orDone and not orrFiredToday and barOfDay <= orrWindow and high >= orHigh - atrVal * orrProx and (isInvHammer or bearCandle) and relVol >= orrRvol)

// ─────────────────────────────────────────────────────────────────────────────
// MODE: VWAP PULLBACK
// ─────────────────────────────────────────────────────────────────────────────

// Trend-following VWAP bounce. ADX confirms trending, EMA aligned, price pulls back to VWAP zone. Supports VWAP session bias filter, S/R confluence requirement, and VWAP-target TP mode.

float vwapStd = ta.stdev(close - vwapValue, 20)
bool pbInZone = vwapDist <= vwapStd * pbZone
bool pbLong = enablePB and (adxValue >= pbAdxMin and emaFast > emaSlow and close > vwapValue - atrVal * 0.25 and pbInZone and bullCandle)
bool pbShort = enablePB and (adxValue >= pbAdxMin and emaFast < emaSlow and close < vwapValue + atrVal * 0.25 and pbInZone and bearCandle)

// ─────────────────────────────────────────────────────────────────────────────
// MODE: VWAP REVERSAL
// ─────────────────────────────────────────────────────────────────────────────

// Mean-reversion fade at VWAP band extremes. ADX low (sideways), VWAP flat, price at band. Supports separate trade window, band touch confirmation, configurable hug limit, RR-based TP, and S/R confluence requirement.

float revUpper = vwapValue + ta.stdev(close - vwapValue, 20) * revBandMult
float revLower = vwapValue - ta.stdev(close - vwapValue, 20) * revBandMult
bool vwapFlat = math.abs(vwapValue - vwapValue[5]) <= atrVal * 0.05
bool revLong = enableREV and (adxValue < revAdxMax and vwapFlat and low <= revLower + atrVal * 0.3 and bullCandle and bodySize >= atrVal * revBody)
bool revShort = enableREV and (adxValue < revAdxMax and vwapFlat and high >= revUpper - atrVal * 0.3 and bearCandle and bodySize >= atrVal * revBody)

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL AGGREGATION
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition = false
bool shortCondition = false
var string activeMode = ""

if psLong
    longCondition := true
    activeMode := "PS"
else if orbLong
    longCondition := true
    activeMode := "ORB"
else if orrLong
    longCondition := true
    activeMode := "ORR"
else if pbLong
    longCondition := true
    activeMode := "PB"
else if revLong
    longCondition := true
    activeMode := "REV"

if psShort
    shortCondition := true
    activeMode := "PS"
else if orbShort
    shortCondition := true
    activeMode := "ORB"
else if orrShort
    shortCondition := true
    activeMode := "ORR"
else if pbShort
    shortCondition := true
    activeMode := "PB"
else if revShort
    shortCondition := true
    activeMode := "REV"

// ─────────────────────────────────────────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────────────────────────────────────────

bool isMarket = session.ismarket
bool isNewDay = timeframe.change("D")
int  barOfDay = ta.barssince(isNewDay) + 1

// ─────────────────────────────────────────────────────────────────────────────
// POSITION SIZING
// ─────────────────────────────────────────────────────────────────────────────

f_qty(float entry, float stop) =>
    float cap    = 100000.0
    float risk   = cap * (1.0 / 100.0)
    float perSh  = math.abs(entry - stop)
    float raw    = perSh > 0 ? risk / perSh : 1.0
    float maxQty = entry > 0 ? cap / entry * 0.95 : 1.0
    math.max(math.min(raw, maxQty), 1.0)

// ─────────────────────────────────────────────────────────────────────────────
// RISK MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

var int   dayTrades  = 0
var int   lastBarEntry = 0
var int   consecLoss = 0
var bool  tripped    = false
var float dayEquity  = 0.0
var bool  dayLimited = false

if isNewDay
    dayTrades  := 0
    lastBarEntry := 0
    consecLoss := 0
    tripped    := false
    dayEquity  := strategy.equity
    dayLimited := false

if dayEquity > 0 and (strategy.equity - dayEquity) / dayEquity * 100 <= -3.0
    dayLimited := true

bool ready  = isMarket and dayTrades < 4 and not tripped and not dayLimited
bool spaced = (bar_index - lastBarEntry) >= 3 or lastBarEntry == 0
bool exitLongCond  = strategy.position_size > 0 and (shortCondition)
bool exitShortCond = strategy.position_size < 0 and (longCondition)

// ─────────────────────────────────────────────────────────────────────────────
// SL / TP CALCULATION
// ─────────────────────────────────────────────────────────────────────────────

float atrVal   = ta.atr(14)
float slRisk   = math.min(atrVal * 1.5, 2.0)
float longSL   = close - slRisk
float longTP   = close + slRisk * 1.5
float shortSL  = close + slRisk
float shortTP  = close - slRisk * 1.5

// ─────────────────────────────────────────────────────────────────────────────
// EXECUTION
// ─────────────────────────────────────────────────────────────────────────────

var float  pendingSL  = na
var float  pendingTP_ = na
var int    pendingDir = 0

bool goLong  = longCondition and ready and spaced and barstate.isconfirmed
bool goShort = shortCondition and ready and spaced and barstate.isconfirmed

if goLong
    if strategy.position_size < 0
        strategy.close("S", comment="Flip")
    float qty = f_qty(close, longSL)
    strategy.entry("L", strategy.long, qty=qty, comment=activeMode + "|L")
    strategy.exit("LX", "L", stop=longSL, limit=longTP)
    dayTrades    += 1
    lastBarEntry := bar_index
    pendingSL    := longSL
    pendingTP_   := longTP
    pendingDir   := 1
    alert("VWAP Composite Strategy: LONG | E " + str.tostring(close, format.mintick) + " | SL " + str.tostring(longSL, format.mintick) + " | TP " + str.tostring(longTP, format.mintick) + " | Qty " + str.tostring(qty, "#"), alert.freq_once_per_bar_close)

if goShort
    if strategy.position_size > 0
        strategy.close("L", comment="Flip")
    float qty = f_qty(close, shortSL)
    strategy.entry("S", strategy.short, qty=qty, comment=activeMode + "|S")
    strategy.exit("SX", "S", stop=shortSL, limit=shortTP)
    dayTrades    += 1
    lastBarEntry := bar_index
    pendingSL    := shortSL
    pendingTP_   := shortTP
    pendingDir   := -1
    alert("VWAP Composite Strategy: SHORT | E " + str.tostring(close, format.mintick) + " | SL " + str.tostring(shortSL, format.mintick) + " | TP " + str.tostring(shortTP, format.mintick) + " | Qty " + str.tostring(qty, "#"), alert.freq_once_per_bar_close)

// Condition-based exits (strategy SL/TP handled by strategy.exit)
if exitLongCond
    strategy.close("L", comment="ExitLong")
if exitShortCond
    strategy.close("S", comment="ExitShort")


// ─────────────────────────────────────────────────────────────────────────────
// TRADE LABELS
// ─────────────────────────────────────────────────────────────────────────────

bool newLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
float fillPrice = strategy.position_avg_price

if newLong and not na(pendingSL) and pendingDir == 1
    label.new(bar_index, low - atrVal * 0.5,
         "\U0001F4C8 LONG" +
         "\n" + activeMode +
         "\nE  " + str.tostring(fillPrice, format.mintick) +
         "\nS  " + str.tostring(pendingSL, format.mintick) +
         "\nT  " + str.tostring(pendingTP_, format.mintick),
         style=label.style_label_up,
         color=color.new(#1B5E20, 0),
         textcolor=color.new(#FFFFFF, 0),
         size=size.small)

if newShort and not na(pendingSL) and pendingDir == -1
    label.new(bar_index, high + atrVal * 0.5,
         "\U0001F4C9 SHORT" +
         "\n" + activeMode +
         "\nE  " + str.tostring(fillPrice, format.mintick) +
         "\nS  " + str.tostring(pendingSL, format.mintick) +
         "\nT  " + str.tostring(pendingTP_, format.mintick),
         style=label.style_label_down,
         color=color.new(#B71C1C, 0),
         textcolor=color.new(#FFFFFF, 0),
         size=size.small)


// ─────────────────────────────────────────────────────────────────────────────
// EXIT MANAGEMENT — BREAKEVEN + FILL ALIGNMENT
// ─────────────────────────────────────────────────────────────────────────────

var float entryPrice = na
var float origSL     = na
var float pendingTP  = na
var bool  movedBE    = false
float beBuf = 0.05

// Position open — capture fill price and realign exits
if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryPrice := strategy.position_avg_price
    movedBE    := false
    if strategy.position_size > 0
        float _slDist = slRisk
        origSL    := entryPrice - _slDist
        pendingTP := entryPrice + _slDist * 1.5
        strategy.exit("LX", "L", stop=origSL, limit=pendingTP)
    else
        float _slDist = slRisk
        origSL    := entryPrice + _slDist
        pendingTP := entryPrice - _slDist * 1.5
        strategy.exit("SX", "S", stop=origSL, limit=pendingTP)

// Breakeven trigger at 0.5R
if strategy.position_size > 0 and not movedBE and not na(entryPrice) and not na(origSL)
    float riskAmt = entryPrice - origSL
    if riskAmt > 0 and close >= entryPrice + riskAmt * 0.5
        strategy.exit("LX", "L", stop=entryPrice + beBuf, limit=pendingTP, comment="BE")
        movedBE := true
        alert("VWAP Composite Strategy: BE LONG | SL → " + str.tostring(entryPrice + beBuf, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size < 0 and not movedBE and not na(entryPrice) and not na(origSL)
    float riskAmt = origSL - entryPrice
    if riskAmt > 0 and close <= entryPrice - riskAmt * 0.5
        strategy.exit("SX", "S", stop=entryPrice - beBuf, limit=pendingTP, comment="BE")
        movedBE := true
        alert("VWAP Composite Strategy: BE SHORT | SL → " + str.tostring(entryPrice - beBuf, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size == 0
    movedBE := false

// ─────────────────────────────────────────────────────────────────────────────
// EOD CLOSE
// ─────────────────────────────────────────────────────────────────────────────

if not isMarket and isMarket[1] and strategy.position_size != 0
    strategy.close_all(comment="EOD")
    alert("VWAP Composite Strategy: EOD CLOSE | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// LOSS TRACKING
// ─────────────────────────────────────────────────────────────────────────────

if strategy.position_size == 0 and strategy.position_size[1] != 0
    float pnl = strategy.netprofit - nz(strategy.netprofit[1])
    if pnl > 0
        consecLoss := 0
    else
        consecLoss += 1
        if consecLoss >= 3
            tripped := true
            alert("VWAP Composite Strategy: CIRCUIT BREAKER | " + str.tostring(consecLoss) + " losses", alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// LEVEL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

var float plotEntry = na
var float plotSL    = na
var float plotTP    = na

if strategy.position_size != 0 and strategy.position_size[1] == 0
    plotEntry := entryPrice
    plotSL    := origSL
    plotTP    := pendingTP
if strategy.position_size == 0
    plotEntry := na
    plotSL    := na
    plotTP    := na

plot(plotEntry, title="Entry Price", color=color.white, style=plot.style_linebr, linewidth=2)
plot(plotTP, title="Take Profit", color=color.new(color.lime, 20), style=plot.style_linebr, linewidth=2)
plot(plotSL, title="Stop Loss", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=2)

// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if strategy.position_size > 0
    bgColor := color.new(color.green, 90)
else if strategy.position_size < 0
    bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")
