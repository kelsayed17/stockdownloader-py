// This Pine Script(tm) v6 strategy is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// VWAP OR Breakout
//
// Momentum breakout beyond opening range with volume confirmation. Fire-once per session. Supports aggressive and retest entry modes, OR-range targets, gap/ADX filters.
//
// Entry Logic:
//   Long  - Price breaks above OR high with volume surge + VWAP alignment
//   Short - Price breaks below OR low with volume surge + VWAP alignment

//@version=6
strategy("VWAP OR Breakout", shorttitle="VWAP-ORB", overlay=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=1.0,
     slippage=1, process_orders_on_close=false, calc_on_every_tick=false,
     margin_long=100, margin_short=100)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────


// --- Shared ---
int    atrLen           = input.int(14, title="ATR Length", minval=1)
int    adxLen           = input.int(14, title="ADX Length", minval=1)
int    emaFastLen       = input.int(9, title="EMA Fast", minval=1)
int    emaSlowLen       = input.int(21, title="EMA Slow", minval=1)
int    orbWindow        = input.int(20, title="Max Bar for ORB", minval=1)
float  orbRvol          = input.float(2.0, title="Min RVOL", minval=1.0, step=0.5)
float  orbBodyMin       = input.float(0.2, title="Min Body (x ATR)", minval=0.0, step=0.05)
string orbEntryMode     = input.string("aggressive", title="Entry Mode")
string orbSlMode        = input.string("OR Opposite", title="SL Mode")
string orbTpMode        = input.string("trail_only", title="TP Mode")
bool   orbReentryExit   = input.bool(false, title="Exit on OR Re-entry")
bool   orbGapFilter     = input.bool(false, title="Gap Alignment Filter")
bool   orbAdxFilter     = input.bool(false, title="ADX Regime Filter")
int    orbTimeExit      = input.int(0, title="Time Exit Bar (0=off)", minval=1)

bool   showLabels    = input.bool(true, title="Show Signal Labels")
bool   showBgColor   = input.bool(true, title="Show Background Coloring")


// ─────────────────────────────────────────────────────────────────────────────
// SESSION DETECTION
// ─────────────────────────────────────────────────────────────────────────────


string SESSION  = "0930-1600"
string TIMEZONE = "America/New_York"

bool inSession = not na(time(timeframe.period, SESSION, TIMEZONE))
bool isNewSession = inSession and not inSession[1]

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────


// Session-Anchored VWAP
float tp = (high + low + close) / 3.0
var float cumTPV = 0.0
var float cumVol = 0.0

if isNewSession
    cumTPV := tp * volume
    cumVol := volume
else
    cumTPV := cumTPV + tp * volume
    cumVol := cumVol + volume

float vwapValue = cumVol != 0 ? cumTPV / cumVol : close
plot(inSession ? vwapValue : na, title="VWAP", color=color.blue, linewidth=2)

float atrVal = ta.atr(atrLen)
plot(atrVal, title="ATR", color=color.new(color.gray, 100), display=display.data_window)
[plusDI, minusDI, adxValue] = ta.dmi(adxLen, adxLen)
float emaFast = ta.ema(close, emaFastLen)
plot(emaFast, title="EMA(emaFastLen)", color=color.teal, linewidth=1)
float emaSlow = ta.ema(close, emaSlowLen)
plot(emaSlow, title="EMA(emaSlowLen)", color=color.orange, linewidth=1)

// ─────────────────────────────────────────────────────────────────────────────
// EXTRA COMPUTATIONS
// ─────────────────────────────────────────────────────────────────────────────

// --- Opening Range Tracking ---
int    orBars        = 3
var float orHigh     = na
var float orLow      = na
var bool  orDone     = false
var int   barOfDay   = 0

if isNewSession
    orHigh  := high
    orLow   := low
    orDone  := false
    barOfDay := 0

barOfDay += 1

if not orDone
    orHigh := math.max(orHigh, high)
    orLow  := math.min(orLow, low)
    if barOfDay >= orBars
        orDone := true

float orRange = orDone ? orHigh - orLow : na

// --- Candle Helpers ---
float bodySize = math.abs(close - open)
bool  bullCandle = close > open and bodySize >= atrVal * 0.15
bool  bearCandle = close < open and bodySize >= atrVal * 0.15

// --- VWAP Distance ---
float vwapDist = math.abs(close - vwapValue)

// --- Relative Volume ---
float avgVol20 = ta.sma(volume, 20)
float relVol   = avgVol20 > 0 ? volume / avgVol20 : 0
var bool orbFiredToday = false
if isNewSession
    orbFiredToday := false

// ─────────────────────────────────────────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────────────────────────────────────────

bool isMarket = session.ismarket
bool isNewDay = timeframe.change("D")
int  barOfDay = ta.barssince(isNewDay) + 1

// ─────────────────────────────────────────────────────────────────────────────
// POSITION SIZING
// ─────────────────────────────────────────────────────────────────────────────

f_qty(float entry, float stop) =>
    float cap    = 100000.0
    float risk   = cap * (1.0 / 100.0)
    float perSh  = math.abs(entry - stop)
    float raw    = perSh > 0 ? risk / perSh : 1.0
    float maxQty = entry > 0 ? cap / entry * 0.95 : 1.0
    math.max(math.min(raw, maxQty), 1.0)

// ─────────────────────────────────────────────────────────────────────────────
// RISK MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

var int   dayTrades  = 0
var int   lastBarEntry = 0
var int   consecLoss = 0
var bool  tripped    = false
var float dayEquity  = 0.0
var bool  dayLimited = false

if isNewDay
    dayTrades  := 0
    lastBarEntry := 0
    consecLoss := 0
    tripped    := false
    dayEquity  := strategy.equity
    dayLimited := false

if dayEquity > 0 and (strategy.equity - dayEquity) / dayEquity * 100 <= -3.0
    dayLimited := true

bool ready  = isMarket and dayTrades < 4 and not tripped and not dayLimited
bool spaced = (bar_index - lastBarEntry) >= 3 or lastBarEntry == 0

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition  = orDone and not orbFiredToday and barOfDay <= orbWindow and close > orHigh and close > open and bodySize >= atrVal * orbBodyMin and relVol >= orbRvol and close > vwapValue
bool shortCondition = orDone and not orbFiredToday and barOfDay <= orbWindow and close < orLow and close < open and bodySize >= atrVal * orbBodyMin and relVol >= orbRvol and close < vwapValue

bool exitLongCond  = strategy.position_size > 0 and (shortCondition)
bool exitShortCond = strategy.position_size < 0 and (longCondition)

// ─────────────────────────────────────────────────────────────────────────────
// SL / TP CALCULATION
// ─────────────────────────────────────────────────────────────────────────────

float atrVal   = ta.atr(14)
float slRisk   = math.min(atrVal * 1.5, 2.0)
float longSL   = close - slRisk
float longTP   = close + slRisk * 1.5
float shortSL  = close + slRisk
float shortTP  = close - slRisk * 1.5

// ─────────────────────────────────────────────────────────────────────────────
// EXECUTION
// ─────────────────────────────────────────────────────────────────────────────

var float  pendingSL  = na
var float  pendingTP_ = na
var int    pendingDir = 0

bool goLong  = longCondition and ready and spaced and barstate.isconfirmed
bool goShort = shortCondition and ready and spaced and barstate.isconfirmed

if goLong
    if strategy.position_size < 0
        strategy.close("S", comment="Flip")
    float qty = f_qty(close, longSL)
    strategy.entry("L", strategy.long, qty=qty, comment="VWAP-ORB|L")
    strategy.exit("LX", "L", stop=longSL, limit=longTP)
    dayTrades    += 1
    lastBarEntry := bar_index
    pendingSL    := longSL
    pendingTP_   := longTP
    pendingDir   := 1
    alert("VWAP OR Breakout: LONG | E " + str.tostring(close, format.mintick) + " | SL " + str.tostring(longSL, format.mintick) + " | TP " + str.tostring(longTP, format.mintick) + " | Qty " + str.tostring(qty, "#"), alert.freq_once_per_bar_close)

if goShort
    if strategy.position_size > 0
        strategy.close("L", comment="Flip")
    float qty = f_qty(close, shortSL)
    strategy.entry("S", strategy.short, qty=qty, comment="VWAP-ORB|S")
    strategy.exit("SX", "S", stop=shortSL, limit=shortTP)
    dayTrades    += 1
    lastBarEntry := bar_index
    pendingSL    := shortSL
    pendingTP_   := shortTP
    pendingDir   := -1
    alert("VWAP OR Breakout: SHORT | E " + str.tostring(close, format.mintick) + " | SL " + str.tostring(shortSL, format.mintick) + " | TP " + str.tostring(shortTP, format.mintick) + " | Qty " + str.tostring(qty, "#"), alert.freq_once_per_bar_close)

// Condition-based exits (strategy SL/TP handled by strategy.exit)
if exitLongCond
    strategy.close("L", comment="ExitLong")
if exitShortCond
    strategy.close("S", comment="ExitShort")


// ─────────────────────────────────────────────────────────────────────────────
// TRADE LABELS
// ─────────────────────────────────────────────────────────────────────────────

bool newLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
float fillPrice = strategy.position_avg_price

if newLong and not na(pendingSL) and pendingDir == 1
    label.new(bar_index, low - atrVal * 0.5,
         "\U0001F4C8 LONG" +
         "\nVWAP OR Breakout" +
         "\nE  " + str.tostring(fillPrice, format.mintick) +
         "\nS  " + str.tostring(pendingSL, format.mintick) +
         "\nT  " + str.tostring(pendingTP_, format.mintick),
         style=label.style_label_up,
         color=color.new(#1B5E20, 0),
         textcolor=color.new(#FFFFFF, 0),
         size=size.small)

if newShort and not na(pendingSL) and pendingDir == -1
    label.new(bar_index, high + atrVal * 0.5,
         "\U0001F4C9 SHORT" +
         "\nVWAP OR Breakout" +
         "\nE  " + str.tostring(fillPrice, format.mintick) +
         "\nS  " + str.tostring(pendingSL, format.mintick) +
         "\nT  " + str.tostring(pendingTP_, format.mintick),
         style=label.style_label_down,
         color=color.new(#B71C1C, 0),
         textcolor=color.new(#FFFFFF, 0),
         size=size.small)


// ─────────────────────────────────────────────────────────────────────────────
// EXIT MANAGEMENT — BREAKEVEN + FILL ALIGNMENT
// ─────────────────────────────────────────────────────────────────────────────

var float entryPrice = na
var float origSL     = na
var float pendingTP  = na
var bool  movedBE    = false
float beBuf = 0.05

// Position open — capture fill price and realign exits
if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryPrice := strategy.position_avg_price
    movedBE    := false
    if strategy.position_size > 0
        float _slDist = slRisk
        origSL    := entryPrice - _slDist
        pendingTP := entryPrice + _slDist * 1.5
        strategy.exit("LX", "L", stop=origSL, limit=pendingTP)
    else
        float _slDist = slRisk
        origSL    := entryPrice + _slDist
        pendingTP := entryPrice - _slDist * 1.5
        strategy.exit("SX", "S", stop=origSL, limit=pendingTP)

// Breakeven trigger at 0.5R
if strategy.position_size > 0 and not movedBE and not na(entryPrice) and not na(origSL)
    float riskAmt = entryPrice - origSL
    if riskAmt > 0 and close >= entryPrice + riskAmt * 0.5
        strategy.exit("LX", "L", stop=entryPrice + beBuf, limit=pendingTP, comment="BE")
        movedBE := true
        alert("VWAP OR Breakout: BE LONG | SL → " + str.tostring(entryPrice + beBuf, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size < 0 and not movedBE and not na(entryPrice) and not na(origSL)
    float riskAmt = origSL - entryPrice
    if riskAmt > 0 and close <= entryPrice - riskAmt * 0.5
        strategy.exit("SX", "S", stop=entryPrice - beBuf, limit=pendingTP, comment="BE")
        movedBE := true
        alert("VWAP OR Breakout: BE SHORT | SL → " + str.tostring(entryPrice - beBuf, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size == 0
    movedBE := false

// ─────────────────────────────────────────────────────────────────────────────
// EOD CLOSE
// ─────────────────────────────────────────────────────────────────────────────

if not isMarket and isMarket[1] and strategy.position_size != 0
    strategy.close_all(comment="EOD")
    alert("VWAP OR Breakout: EOD CLOSE | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// LOSS TRACKING
// ─────────────────────────────────────────────────────────────────────────────

if strategy.position_size == 0 and strategy.position_size[1] != 0
    float pnl = strategy.netprofit - nz(strategy.netprofit[1])
    if pnl > 0
        consecLoss := 0
    else
        consecLoss += 1
        if consecLoss >= 3
            tripped := true
            alert("VWAP OR Breakout: CIRCUIT BREAKER | " + str.tostring(consecLoss) + " losses", alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// LEVEL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

var float plotEntry = na
var float plotSL    = na
var float plotTP    = na

if strategy.position_size != 0 and strategy.position_size[1] == 0
    plotEntry := entryPrice
    plotSL    := origSL
    plotTP    := pendingTP
if strategy.position_size == 0
    plotEntry := na
    plotSL    := na
    plotTP    := na

plot(plotEntry, title="Entry Price", color=color.white, style=plot.style_linebr, linewidth=2)
plot(plotTP, title="Take Profit", color=color.new(color.lime, 20), style=plot.style_linebr, linewidth=2)
plot(plotSL, title="Stop Loss", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=2)


// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if strategy.position_size > 0
    bgColor := color.new(color.green, 90)
else if strategy.position_size < 0
    bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")

