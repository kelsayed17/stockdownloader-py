// This Pine Script(tm) v6 strategy is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// SPY ML Ensemble
//
// ML Ensemble Strategy with dynamic confidence-scaled TP/SL.
// Surrogate decision tree approximates full ensemble probability.
// Features: regime_bb_width_pctl, adx14_norm, minus_di_norm, adx_slope_3, regime_adx_norm, price_vs_sma50_atr, plus_di_norm, adx_score (+17 more)
// 
// Dynamic exits: SL tightens and TP expands with higher confidence.
// Optional 15-minute VWAP multi-timeframe confirmation.
//
// Entry Logic:
//   Long  - ML prob above threshold + VWAP confirmation
//   Short - ML prob below threshold + VWAP confirmation

//@version=6
strategy("SPY ML Ensemble", shorttitle="SPY-ML-ENS", overlay=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=1.0,
     slippage=1, process_orders_on_close=false, calc_on_every_tick=false,
     margin_long=100, margin_short=100)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────


// --- ML Signal ---
float  buyThresh        = input.float(0.55, title="Buy Threshold", minval=0.0, step=0.05)
float  sellThresh       = input.float(0.45, title="Sell Threshold", minval=0.0, step=0.05)

// --- Risk ---
int    atrLen           = input.int(14, title="ATR Length", minval=1)
float  baseSL           = input.float(2.0, title="Base SL (x ATR)", minval=0.5, step=0.25)
float  baseTP           = input.float(2.0, title="Base TP (x ATR)", minval=0.5, step=0.25)
float  slCapDollars     = input.float(3.0, title="SL Cap ($, 0=off)", minval=0.0, step=0.25)
int    circuitMax       = input.int(3, title="Circuit Breaker Losses", minval=1)

// --- Multi-Timeframe ---
bool   useVwapConfirm   = input.bool(true, title="Use 15-min VWAP Confirmation")

// --- Session ---
bool   closeEOD         = input.bool(true, title="Close at End of Day")

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────


// ─────────────────────────────────────────────────────────────────────────────
// EXTRA COMPUTATIONS
// ─────────────────────────────────────────────────────────────────────────────

[pDiPlus, pDiMinus, pAdxVal] = ta.dmi(14, 14)
float pAtr14 = nz(ta.atr(14), 1.0)
float pR1 = (close - close[1]) / nz(close[1])
float pR2 = (close[1] - close[2]) / nz(close[2])
float pR3 = (close[2] - close[3]) / nz(close[3])
float pR4 = (close[3] - close[4]) / nz(close[4])
float pR5 = (close[4] - close[5]) / nz(close[5])
float pMeanR5 = (pR1 + pR2 + pR3 + pR4 + pR5) / 5.0
float pRealVol5d = math.sqrt((math.pow(pR1 - pMeanR5, 2) + math.pow(pR2 - pMeanR5, 2) + math.pow(pR3 - pMeanR5, 2) + math.pow(pR4 - pMeanR5, 2) + math.pow(pR5 - pMeanR5, 2)) / 5.0)
[pBbMid, pBbUp, pBbLo] = ta.bb(close, 20, 2.0)
float tn7 = volume / ta.sma(volume, 20) <= 0.824972 ? 0.4617 : 0.4152
float tn5 = (month - 1) / 11.0 <= 0.590909 ? 0.5099 : tn7
float tn12 = 0.5 <= 0.764463 ? 0.3750 : 0.3150
float tn10 = volume / ta.sma(volume, 20) <= 0.820599 ? 0.4275 : tn12
float tn4 = ta.rsi(close, 14) / 100.0 <= 0.607851 ? tn5 : tn10
float tn21 = pDiMinus / 100.0 <= 0.194081 ? 0.3902 : 0.4674
float tn19 = 0.5 <= 0.235537 ? 0.5102 : tn21
float tn17 = ((close > ta.sar(0.02, 0.02, 0.2)) ? 1.0 : -1.0) <= -0.084766 ? 0.3961 : tn19
float tn27 = (ta.rsi(close, 14) - 50.0) / 50.0 <= -0.611357 ? 0.4296 : 0.4795
float tn31 = pAtr14 / close <= 0.009219 ? 0.5131 : 0.5508
float tn30 = (ta.ema(close, 12) - ta.ema(close, 26)) / pAtr14 <= 1.132228 ? tn31 : 0.4666
float tn26 = (close - ta.sma(close, 200)) / (ta.sma(close, 200)) * 100.0 / 100.0 <= 0.079363 ? tn27 : tn30
float tn24 = (pBbUp - pBbLo) / close <= 0.026597 ? 0.5715 : tn26
float tn16 = (pAdxVal - pAdxVal[3]) / 100.0 <= -0.027606 ? tn17 : tn24
float tn15 = 0.5 <= 0.962810 ? tn16 : 0.6012
float tn3 = pAdxVal / 100.0 <= 0.159247 ? tn4 : tn15
float tn41 = (ta.linreg(close, 20, 0) > close[20] ? 1.0 : -1.0) <= 0.186437 ? 0.4447 : 0.4078
float tn44 = (ta.ema(close, 12) - ta.ema(close, 26)) / pAtr14 <= 0.483320 ? 0.4755 : 0.5553
float tn40 = ((close > ta.sar(0.02, 0.02, 0.2)) ? 1.0 : -1.0) <= 0.794228 ? tn41 : tn44
float tn49 = 0.5 <= 0.376033 ? 0.6126 : 0.5454
float tn48 = (month - 1) / 11.0 <= 0.590909 ? tn49 : 0.5259
float tn53 = (close - ta.sma(close, 50)) / pAtr14 <= 2.453104 ? 0.4720 : 0.5336
float tn47 = ((close > ta.sar(0.02, 0.02, 0.2)) ? 1.0 : -1.0) <= 0.790884 ? tn48 : tn53
float tn39 = pDiMinus / 100.0 <= 0.181656 ? tn40 : tn47
float tn38 = (close - ta.sma(close, 200)) / pAtr14 <= 13.992013 ? tn39 : 0.4011
float tn37 = 0.5 <= 0.830579 ? tn38 : 0.3728
float tn65 = (pAdxVal - pAdxVal[3]) / 100.0 <= 0.020054 ? 0.6051 : 0.6378
float tn63 = pDiPlus / 100.0 <= 0.254484 ? 0.5808 : tn65
float tn61 = pAtr14 / close <= 0.008210 ? 0.5713 : tn63
float tn60 = (pBbUp - pBbLo) / close <= 0.066724 ? tn61 : 0.5359
float tn73 = (pBbUp - pBbLo) / close <= 0.068433 ? 0.5286 : 0.4685
float tn72 = 0.5 <= 0.814050 ? tn73 : 0.5872
float tn70 = (close - ta.sma(close, 200)) / (ta.sma(close, 200)) * 100.0 / 100.0 <= 0.000660 ? 0.5899 : tn72
float tn77 = pDiMinus / 100.0 <= 0.155313 ? 0.5779 : 0.6282
float tn69 = (pAdxVal - pAdxVal[3]) / 100.0 <= 0.050932 ? tn70 : tn77
float tn59 = 0.5 <= 0.342975 ? tn60 : tn69
float tn83 = (pAdxVal - pAdxVal[3]) / 100.0 <= 0.026637 ? 0.5369 : 0.5992
float tn88 = (pAdxVal - pAdxVal[3]) / 100.0 <= 0.037221 ? 0.4165 : 0.4975
float tn86 = (close - ta.sma(close, 200)) / (ta.sma(close, 200)) * 100.0 / 100.0 <= 0.107159 ? 0.5385 : tn88
float tn82 = (close - ta.sma(close, 50)) / pAtr14 <= 3.960109 ? tn83 : tn86
float tn80 = pRealVol5d / nz(ta.stdev(ta.roc(close, 1) / 100.0, 20)) <= 0.496116 ? 0.3985 : tn82
float tn58 = (close - ta.sma(close, 200)) / pAtr14 <= 10.465096 ? tn59 : tn80
float tn36 = pAdxVal / 100.0 <= 0.167359 ? tn37 : tn58
float tn2 = (pAdxVal - pAdxVal[3]) / 100.0 <= -0.004069 ? tn3 : tn36
float tn95 = pRealVol5d / nz(ta.stdev(ta.roc(close, 1) / 100.0, 20)) <= 0.681397 ? 0.5564 : 0.6278
float tn93 = (ta.rsi(close, 14) - 50.0) / 50.0 <= -0.518735 ? 0.4918 : tn95
float tn99 = (ta.rsi(close, 14) / 100.0) * (pAdxVal / 100.0) <= 0.039898 ? 0.6645 : 0.5873
float tn105 = ta.mfi(hlc3, 14) / 100.0 <= 0.536003 ? 0.6843 : 0.7112
float tn103 = (close - ta.sma(close, 200)) / pAtr14 <= 5.009891 ? 0.7426 : tn105
float tn102 = 0.0 <= 0.122078 ? tn103 : 0.6414
float tn98 = (ta.ema(close, 12) - ta.ema(close, 26)) / pAtr14 <= 0.425404 ? tn99 : tn102
float tn92 = 0.5 <= 0.712788 ? tn93 : tn98
float tn115 = (close - ta.sma(close, 200)) / pAtr14 <= 5.141603 ? 0.4525 : 0.5177
float tn114 = pAtr14 / close <= 0.016227 ? tn115 : 0.5360
float tn113 = (pAdxVal - pAdxVal[3]) / 100.0 <= 0.028968 ? tn114 : 0.5668
float tn122 = (pAdxVal - pAdxVal[3]) / 100.0 <= 0.001931 ? 0.4558 : 0.5201
float tn125 = 0.5 <= 0.483471 ? 0.4367 : 0.3988
float tn121 = pAdxVal / 100.0 <= 0.124960 ? tn122 : tn125
float tn120 = (pBbUp - pBbLo) / close <= 0.066044 ? tn121 : 0.5263
float tn112 = (close - ta.sma(close, 50)) / pAtr14 <= -0.467589 ? tn113 : tn120
float tn133 = (ta.ema(close, 12) - ta.ema(close, 26)) / pAtr14 <= -0.133394 ? 0.4605 : 0.5494
float tn131 = pAtr14 / close <= 0.008269 ? 0.4557 : tn133
float tn137 = ((close > ta.sar(0.02, 0.02, 0.2)) ? 1.0 : -1.0) <= -0.271275 ? 0.5334 : 0.6136
float tn140 = volume / ta.sma(volume, 20) <= 0.920583 ? 0.5748 : 0.5297
float tn136 = 0.5 <= 0.351240 ? tn137 : tn140
float tn130 = (pAdxVal - pAdxVal[3]) / 100.0 <= -0.032460 ? tn131 : tn136
float tn129 = ta.rsi(close, 14) / 100.0 <= 0.644680 ? tn130 : 0.4041
float tn111 = ((close > ta.sar(0.02, 0.02, 0.2)) ? 1.0 : -1.0) <= -0.363362 ? tn112 : tn129
float tn149 = (ta.rsi(close, 14) - 50.0) / 50.0 <= -0.141433 ? 0.3874 : 0.3691
float tn147 = (ta.ema(close, 12) - ta.ema(close, 26)) / pAtr14 <= 0.237683 ? 0.4117 : tn149
float tn146 = ta.rsi(close, 14) / 100.0 <= 0.594159 ? tn147 : 0.3376
float tn144 = volume / ta.sma(volume, 20) <= 0.809403 ? 0.4757 : tn146
float tn110 = 0.5 <= 0.789256 ? tn111 : tn144
float tn158 = ta.rsi(close, 14) / 100.0 <= 0.530121 ? 0.5292 : 0.5922
float tn161 = (pAdxVal > 25 ? (pDiPlus > pDiMinus ? 1.0 : -1.0) : 0.0) <= -0.089492 ? 0.6385 : 0.5997
float tn157 = pDiMinus / 100.0 <= 0.299326 ? tn158 : tn161
float tn165 = (ta.mfi(hlc3, 14) - 50.0) / 50.0 <= 0.474667 ? 0.6359 : 0.6710
float tn168 = pRealVol5d / nz(ta.stdev(ta.roc(close, 1) / 100.0, 20)) <= 1.055755 ? 0.6200 : 0.5689
float tn164 = 0.5 <= 0.772727 ? tn165 : tn168
float tn156 = (pAdxVal - pAdxVal[3]) / 100.0 <= 0.007777 ? tn157 : tn164
float tn171 = 0.5 <= 0.527871 ? 0.5925 : 0.4516
float tn155 = pRealVol5d / nz(ta.stdev(ta.roc(close, 1) / 100.0, 20)) <= 1.602821 ? tn156 : tn171
float tn176 = pDiPlus / 100.0 <= 0.263484 ? 0.4865 : 0.5774
float tn174 = volume / ta.sma(volume, 20) <= 0.868858 ? 0.4631 : tn176
float tn154 = (close - ta.sma(close, 200)) / pAtr14 <= 11.491559 ? tn155 : tn174
float tn182 = pAtr14 / close <= 0.017922 ? 0.4844 : 0.5956
float tn187 = volume / ta.sma(volume, 20) <= 0.899468 ? 0.6804 : 0.6385
float tn185 = (ta.mfi(hlc3, 14) - 50.0) / 50.0 <= 0.442493 ? 0.5752 : tn187
float tn181 = pDiMinus / 100.0 <= 0.303628 ? tn182 : tn185
float tn190 = (pAdxVal - pAdxVal[3]) / 100.0 <= 0.056277 ? 0.5501 : 0.4381
float tn180 = pRealVol5d / nz(ta.stdev(ta.roc(close, 1) / 100.0, 20)) <= 1.426922 ? tn181 : tn190
float tn195 = volume / ta.sma(volume, 20) <= 1.274761 ? 0.6295 : 0.5034
float tn200 = pDiMinus / 100.0 <= 0.336007 ? 0.5075 : 0.4354
float tn198 = pDiMinus / 100.0 <= 0.262058 ? 0.4183 : tn200
float tn194 = (ta.linreg(close, 20, 0) > close[20] ? 1.0 : -1.0) <= -0.198115 ? tn195 : tn198
float tn204 = 0.5 <= 0.549637 ? 0.6052 : 0.6519
float tn209 = (close - ta.sma(close, 200)) / (ta.sma(close, 200)) * 100.0 / 100.0 <= 0.046130 ? 0.5216 : 0.5769
float tn207 = (month - 1) / 11.0 <= 0.045455 ? 0.6360 : tn209
float tn203 = 0.5 <= 0.322314 ? tn204 : tn207
float tn193 = ((close > ta.sar(0.02, 0.02, 0.2)) ? 1.0 : -1.0) <= -0.317491 ? tn194 : tn203
float tn179 = pDiPlus / 100.0 <= 0.156370 ? tn180 : tn193
float tn153 = pAtr14 / close <= 0.014358 ? tn154 : tn179
float tn109 = pAdxVal / 100.0 <= 0.169044 ? tn110 : tn153
float tn91 = pAdxVal / 100.0 <= 0.093979 ? tn92 : tn109
float tn1 = pDiMinus / 100.0 <= 0.206633 ? tn2 : tn91
float tn216 = ta.mfi(hlc3, 14) / 100.0 <= 0.709234 ? 0.5825 : 0.5360
float tn219 = (close - ta.sma(close, 50)) / pAtr14 <= 5.279202 ? 0.5142 : 0.4488
float tn215 = pAtr14 / close <= 0.007255 ? tn216 : tn219
float tn227 = 0.5 <= 0.577306 ? 0.4312 : 0.4003
float tn226 = 0.5 <= 0.446281 ? tn227 : 0.3754
float tn225 = pDiMinus / 100.0 <= 0.181879 ? tn226 : 0.4612
float tn224 = pDiPlus / 100.0 <= 0.383420 ? tn225 : 0.5456
float tn236 = 0.5 <= 0.488457 ? 0.5471 : 0.4981
float tn234 = ((close > ta.sar(0.02, 0.02, 0.2)) ? 1.0 : -1.0) <= 0.525745 ? 0.5763 : tn236
float tn233 = pDiPlus / 100.0 <= 0.375161 ? tn234 : 0.4193
float tn223 = (pAdxVal - pAdxVal[3]) / 100.0 <= 0.025826 ? tn224 : tn233
float tn222 = ta.rsi(close, 14) / 100.0 <= 0.748253 ? tn223 : 0.3815
float tn214 = (month - 1) / 11.0 <= 0.136364 ? tn215 : tn222
float tn242 = volume / ta.sma(volume, 20) <= 0.847869 ? 0.4869 : 0.4030
float tn245 = (pAdxVal - pAdxVal[3]) / 100.0 <= 0.010694 ? 0.3161 : 0.3534
float tn241 = (close - ta.sma(close, 200)) / pAtr14 <= 13.740971 ? tn242 : tn245
float tn213 = (close - ta.sma(close, 200)) / (ta.sma(close, 200)) * 100.0 / 100.0 <= 0.120616 ? tn214 : tn241
float tn250 = pDiPlus / 100.0 <= 0.346248 ? 0.5309 : 0.4439
float tn249 = (close - ta.sma(close, 200)) / pAtr14 <= 11.338865 ? tn250 : 0.3483
float tn256 = (close - ta.sma(close, 200)) / pAtr14 <= 12.567699 ? 0.3606 : 0.2818
float tn255 = (pAdxVal - pAdxVal[3]) / 100.0 <= 0.060364 ? tn256 : 0.3911
float tn260 = pAdxVal / 100.0 <= 0.549622 ? 0.2530 : 0.2932
float tn254 = pAdxVal / 100.0 <= 0.496914 ? tn255 : tn260
float tn248 = ta.mfi(hlc3, 14) / 100.0 <= 0.664769 ? tn249 : tn254
float tn212 = pAdxVal / 100.0 <= 0.373004 ? tn213 : tn248
float tn0 = (close - ta.sma(close, 50)) / pAtr14 <= 4.618555 ? tn1 : tn212
float mlProb = tn0
float confidence = math.abs(mlProb - 0.5) * 2.0

// 15-minute VWAP for multi-timeframe confirmation
float vwap15 = request.security(syminfo.tickerid, '15', ta.vwap)
bool vwapBullish = not useVwapConfirm or close > vwap15
bool vwapBearish = not useVwapConfirm or close < vwap15

// ML-driven entry signals
bool buySignal  = mlProb > buyThresh and vwapBullish
bool sellSignal = mlProb < sellThresh and vwapBearish

// ─────────────────────────────────────────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────────────────────────────────────────

bool isMarket = session.ismarket
bool isNewDay = timeframe.change("D")
int  barOfDay = ta.barssince(isNewDay) + 1

// ─────────────────────────────────────────────────────────────────────────────
// POSITION SIZING
// ─────────────────────────────────────────────────────────────────────────────

f_qty(float entry, float stop) =>
    float cap    = 100000.0
    float risk   = cap * (1.0 / 100.0)
    float perSh  = math.abs(entry - stop)
    float raw    = perSh > 0 ? risk / perSh : 1.0
    float maxQty = entry > 0 ? cap / entry * 0.95 : 1.0
    math.max(math.min(raw, maxQty), 1.0)

// ─────────────────────────────────────────────────────────────────────────────
// RISK MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

var int   dayTrades  = 0
var int   lastBarEntry = 0
var int   consecLoss = 0
var bool  tripped    = false
var float dayEquity  = 0.0
var bool  dayLimited = false

if isNewDay
    dayTrades  := 0
    lastBarEntry := 0
    consecLoss := 0
    tripped    := false
    dayEquity  := strategy.equity
    dayLimited := false

if dayEquity > 0 and (strategy.equity - dayEquity) / dayEquity * 100 <= -3.0
    dayLimited := true

bool ready  = isMarket and dayTrades < 4 and not tripped and not dayLimited
bool spaced = (bar_index - lastBarEntry) >= 3 or lastBarEntry == 0

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition  = buySignal
bool shortCondition = sellSignal

bool exitLongCond  = strategy.position_size > 0 and (false)
bool exitShortCond = strategy.position_size < 0 and (false)

// ─────────────────────────────────────────────────────────────────────────────
// SL / TP CALCULATION
// ─────────────────────────────────────────────────────────────────────────────

float atrVal   = ta.atr(14)
float slRisk   = math.min(atrVal * 2.0, 3.0)
float longSL   = close - slRisk
float longTP   = close + slRisk * 2.0
float shortSL  = close + slRisk
float shortTP  = close - slRisk * 2.0

// ─────────────────────────────────────────────────────────────────────────────
// EXECUTION
// ─────────────────────────────────────────────────────────────────────────────

bool goLong  = longCondition and ready and spaced and barstate.isconfirmed
bool goShort = shortCondition and ready and spaced and barstate.isconfirmed

if goLong
    if strategy.position_size < 0
        strategy.close("S", comment="Flip")
    float qty = f_qty(close, longSL)
    strategy.entry("L", strategy.long, qty=qty, comment="SPY-ML-ENS|L")
    strategy.exit("LX", "L", stop=longSL, limit=longTP)
    dayTrades    += 1
    lastBarEntry := bar_index
    alert("SPY ML Ensemble: LONG | E " + str.tostring(close, format.mintick) + " | SL " + str.tostring(longSL, format.mintick) + " | TP " + str.tostring(longTP, format.mintick) + " | Qty " + str.tostring(qty, "#"), alert.freq_once_per_bar_close)
    label.new(bar_index, low, "Buy",
         style=label.style_label_up,
         color=color.green,
         textcolor=color.white,
         size=size.small)

if goShort
    if strategy.position_size > 0
        strategy.close("L", comment="Flip")
    float qty = f_qty(close, shortSL)
    strategy.entry("S", strategy.short, qty=qty, comment="SPY-ML-ENS|S")
    strategy.exit("SX", "S", stop=shortSL, limit=shortTP)
    dayTrades    += 1
    lastBarEntry := bar_index
    alert("SPY ML Ensemble: SHORT | E " + str.tostring(close, format.mintick) + " | SL " + str.tostring(shortSL, format.mintick) + " | TP " + str.tostring(shortTP, format.mintick) + " | Qty " + str.tostring(qty, "#"), alert.freq_once_per_bar_close)
    label.new(bar_index, high, "Sell",
         style=label.style_label_down,
         color=color.red,
         textcolor=color.white,
         size=size.small)

// Condition-based exits (strategy SL/TP handled by strategy.exit)
if exitLongCond
    strategy.close("L", comment="ExitLong")
    label.new(bar_index, high, "Exit Long",
         style=label.style_label_down,
         color=color.orange,
         textcolor=color.white,
         size=size.small)
if exitShortCond
    strategy.close("S", comment="ExitShort")
    label.new(bar_index, low, "Exit Short",
         style=label.style_label_up,
         color=color.orange,
         textcolor=color.white,
         size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// EXIT MANAGEMENT — BREAKEVEN + FILL ALIGNMENT
// ─────────────────────────────────────────────────────────────────────────────

var float entryPrice = na
var float origSL     = na
var float pendingTP  = na
var bool  movedBE    = false
float beBuf = 0.05

// Position open — capture fill price and realign exits
if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryPrice := strategy.position_avg_price
    movedBE    := false
    if strategy.position_size > 0
        float _slDist = slRisk
        origSL    := entryPrice - _slDist
        pendingTP := entryPrice + _slDist * 2.0
        strategy.exit("LX", "L", stop=origSL, limit=pendingTP)
    else
        float _slDist = slRisk
        origSL    := entryPrice + _slDist
        pendingTP := entryPrice - _slDist * 2.0
        strategy.exit("SX", "S", stop=origSL, limit=pendingTP)

// Breakeven trigger at 0.5R
if strategy.position_size > 0 and not movedBE and not na(entryPrice) and not na(origSL)
    float riskAmt = entryPrice - origSL
    if riskAmt > 0 and close >= entryPrice + riskAmt * 0.5
        strategy.exit("LX", "L", stop=entryPrice + beBuf, limit=pendingTP, comment="BE")
        movedBE := true
        alert("SPY ML Ensemble: BE LONG | SL → " + str.tostring(entryPrice + beBuf, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size < 0 and not movedBE and not na(entryPrice) and not na(origSL)
    float riskAmt = origSL - entryPrice
    if riskAmt > 0 and close <= entryPrice - riskAmt * 0.5
        strategy.exit("SX", "S", stop=entryPrice - beBuf, limit=pendingTP, comment="BE")
        movedBE := true
        alert("SPY ML Ensemble: BE SHORT | SL → " + str.tostring(entryPrice - beBuf, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size == 0
    movedBE := false

// ─────────────────────────────────────────────────────────────────────────────
// EOD CLOSE
// ─────────────────────────────────────────────────────────────────────────────

if not isMarket and isMarket[1] and strategy.position_size != 0
    strategy.close_all(comment="EOD")
    alert("SPY ML Ensemble: EOD CLOSE | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// LOSS TRACKING
// ─────────────────────────────────────────────────────────────────────────────

if strategy.position_size == 0 and strategy.position_size[1] != 0
    float pnl = strategy.netprofit - nz(strategy.netprofit[1])
    if pnl > 0
        consecLoss := 0
    else
        consecLoss += 1
        if consecLoss >= 3
            tripped := true
            alert("SPY ML Ensemble: CIRCUIT BREAKER | " + str.tostring(consecLoss) + " losses", alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// LEVEL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

var float plotEntry = na
var float plotSL    = na
var float plotTP    = na

if strategy.position_size != 0 and strategy.position_size[1] == 0
    plotEntry := entryPrice
    plotSL    := origSL
    plotTP    := pendingTP
if strategy.position_size == 0
    plotEntry := na
    plotSL    := na
    plotTP    := na

plot(plotEntry, title="Entry Price", color=color.white, style=plot.style_linebr, linewidth=2)
plot(plotTP, title="Take Profit", color=color.new(color.lime, 20), style=plot.style_linebr, linewidth=2)
plot(plotSL, title="Stop Loss", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=2)


// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if strategy.position_size > 0
    bgColor := color.new(color.green, 90)
else if strategy.position_size < 0
    bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")


// ─────────────────────────────────────────────────────────────────────────────
// ADDITIONAL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════
// DYNAMIC ML-DRIVEN TP/SL OVERRIDE
// ═══════════════════════════════════════════════════════════════

float atrDyn = ta.atr(atrLen)
float dynamicSL = atrDyn * (baseSL - confidence * 0.5)
float dynamicTP = atrDyn * (baseTP + confidence * 1.0)

// Cap SL if slCapDollars > 0
float cappedSL = slCapDollars > 0 ? math.min(dynamicSL, slCapDollars) : dynamicSL

// Override the renderer's fixed exits with dynamic ones
if strategy.position_size > 0
    float dynLongSL = strategy.position_avg_price - cappedSL
    float dynLongTP = strategy.position_avg_price + dynamicTP
    strategy.exit("LX", "L", stop=dynLongSL, limit=dynLongTP)
if strategy.position_size < 0
    float dynShortSL = strategy.position_avg_price + cappedSL
    float dynShortTP = strategy.position_avg_price - dynamicTP
    strategy.exit("SX", "S", stop=dynShortSL, limit=dynShortTP)

// ═══════════════════════════════════════════════════════════════
// CUSTOM EOD CLOSE (respects closeEOD input toggle)
// ═══════════════════════════════════════════════════════════════

if closeEOD and not session.ismarket and session.ismarket[1] and strategy.position_size != 0
    strategy.close_all(comment="EOD")

// ═══════════════════════════════════════════════════════════════
// BACKGROUND COLORING
// ═══════════════════════════════════════════════════════════════

color mlBg = strategy.position_size > 0 ? color.new(color.green, 90) : strategy.position_size < 0 ? color.new(color.red, 90) : na
bgcolor(mlBg, title="ML Position Zone")

// ═══════════════════════════════════════════════════════════════
// ENTRY LABELS
// ═══════════════════════════════════════════════════════════════

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    label.new(bar_index, low, "\u25B2", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.small)
if strategy.position_size < 0 and strategy.position_size[1] >= 0
    label.new(bar_index, high, "\u25BC", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)

// ═══════════════════════════════════════════════════════════════
// TP/SL/ENTRY LEVEL PLOTS
// ═══════════════════════════════════════════════════════════════

var float mlEntryPrice  = na
var float mlStopPrice   = na
var float mlTargetPrice = na

if strategy.position_size != 0 and strategy.position_size[1] == 0
    mlEntryPrice := strategy.position_avg_price
    if strategy.position_size > 0
        mlStopPrice   := mlEntryPrice - cappedSL
        mlTargetPrice := mlEntryPrice + dynamicTP
    else
        mlStopPrice   := mlEntryPrice + cappedSL
        mlTargetPrice := mlEntryPrice - dynamicTP
if strategy.position_size == 0
    mlEntryPrice  := na
    mlStopPrice   := na
    mlTargetPrice := na

plot(mlEntryPrice, title="Entry Price", color=color.white, style=plot.style_linebr, linewidth=2)
plot(mlTargetPrice, title="Take Profit", color=color.new(color.lime, 20), style=plot.style_linebr, linewidth=2)
plot(mlStopPrice, title="Stop Loss", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=2)

// ═══════════════════════════════════════════════════════════════
// DATA WINDOW METRICS
// ═══════════════════════════════════════════════════════════════

plot(mlProb, title="ML Probability", color=color.new(color.gray, 100), display=display.data_window)
plot(confidence, title="ML Confidence", color=color.new(color.gray, 100), display=display.data_window)
plot(atrDyn, title="ATR (dynamic)", color=color.new(color.gray, 100), display=display.data_window)
plot(dynamicSL, title="Dynamic SL ($)", color=color.new(color.gray, 100), display=display.data_window)
plot(dynamicTP, title="Dynamic TP ($)", color=color.new(color.gray, 100), display=display.data_window)
