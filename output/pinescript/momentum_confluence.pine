// https://mozilla.org/MPL/2.0/
//
// Momentum Confluence Signals
//
// Multi-indicator momentum strategy requiring confluence of:
// MACD crossover + ADX strength + EMA trend + OBV confirmation.
//
// Entry Logic:
//   Long  - MACD bullish + strong ADX + above EMA trend + OBV rising
//   Short - MACD bearish + strong ADX + below EMA trend

//@version=6
indicator("Momentum Confluence Signals", shorttitle="MOM-CONF", overlay=true, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────


// --- MACD ---
int    fastEma          = input.int(12, title="Fast EMA", minval=1)
int    slowEma          = input.int(26, title="Slow EMA", minval=1)
int    signalLen        = input.int(9, title="Signal Period", minval=1)

// --- Trend ---
int    trendEma         = input.int(200, title="Trend EMA Period", minval=1)
float  adxThresh        = input.float(25.0, title="ADX Threshold", minval=0.0, step=1.0)

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────

[macdLine, macdSignal, macdHist] = ta.macd(close, fastEma, slowEma, signalLen)
float emaTrend = ta.ema(close, trendEma)
plot(emaTrend, title="EMA(trendEma)", color=color.gray, linewidth=1)
[plusDI, minusDI, adxValue] = ta.dmi(14, 14)
float obvRaw = ta.obv
float obvEma = ta.ema(obvRaw, 5)
bool obvUp = obvEma > obvEma[1]

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition = ta.crossover(macdLine, macdSignal) and adxValue > adxThresh and plusDI > minusDI and close > emaTrend and obvUp
bool shortCondition = ta.crossunder(macdLine, macdSignal) and adxValue > adxThresh and minusDI > plusDI and close < emaTrend

// Position state: +1 = long, -1 = short, 0 = flat
var int posState = 0

bool buySignal      = longCondition and posState != 1
bool sellSignal     = shortCondition and posState != -1
bool exitLongSignal  = posState == 1 and (shortCondition)
bool exitShortSignal = posState == -1 and (longCondition)

// Update position state
if buySignal
    posState := 1
else if sellSignal
    posState := -1
else if exitLongSignal or exitShortSignal
    posState := 0

// ─────────────────────────────────────────────────────────────────────────────
// LABELS
// ─────────────────────────────────────────────────────────────────────────────

if true
    if buySignal
        label.new(bar_index, low, "Buy",
             style=label.style_label_up,
             color=color.green,
             textcolor=color.white,
             size=size.small)
    if sellSignal
        label.new(bar_index, high, "Sell",
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.small)
    if exitLongSignal
        label.new(bar_index, high, "Exit Long",
             style=label.style_label_down,
             color=color.orange,
             textcolor=color.white,
             size=size.small)
    if exitShortSignal
        label.new(bar_index, low, "Exit Short",
             style=label.style_label_up,
             color=color.orange,
             textcolor=color.white,
             size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if true
    if posState == 1
        bgColor := color.new(color.green, 90)
    else if posState == -1
        bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────

alertcondition(buySignal,
     title="Buy",
     message="Momentum Confluence Signals: Buy signal triggered.")
alertcondition(sellSignal,
     title="Sell",
     message="Momentum Confluence Signals: Sell signal triggered.")
alertcondition(exitLongSignal,
     title="Exit Long",
     message="Momentum Confluence Signals: Exit Long signal.")
alertcondition(exitShortSignal,
     title="Exit Short",
     message="Momentum Confluence Signals: Exit Short signal.")
alertcondition((buySignal or sellSignal or exitLongSignal or exitShortSignal),
     title="Any Signal",
     message="Momentum Confluence Signals: Signal triggered. Check chart.")
