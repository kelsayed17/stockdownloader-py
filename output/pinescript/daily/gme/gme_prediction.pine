// This Pine Script(tm) v6 strategy is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// GME Quant Regime Prediction
//
// Quantitative regime-adaptive indicator for GME.
// Encodes statistically validated patterns:
// - 4 volatility regimes (Low/Normal/High/Extreme)
// - Volume anomaly detection (z-score breakouts)
// - OBV divergence detection
// - Volatility clustering (big moves follow big moves)
// - ATR-scaled dynamic stops
// 
// Based on: 132% annual vol, Student-t df=1.95,
// VaR 99% = -18.4%, lag-1 |return| ACF = 0.45
//
// Entry Logic:
//   Long  - Normal/High regime + volume anomaly + OBV rising + RSI not overbought + (cluster starting OR regime rising)
//   Short - Normal/High regime + volume anomaly + OBV falling + RSI not oversold + (cluster starting OR regime falling)

//@version=6
strategy("GME Quant Regime Prediction", shorttitle="GME-QRP", overlay=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=1.0,
     slippage=1, process_orders_on_close=false, calc_on_every_tick=false,
     margin_long=100, margin_short=100)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────


// --- Volatility Regime ---
int    volWindow        = input.int(20, title="Volatility Window", minval=5)
int    volAnnFactor     = input.int(252, title="Annualization Factor", minval=1)
float  regimeHighMult   = input.float(1.5, title="High Regime Threshold (x median)", minval=0.5, step=0.1)
float  regimeExtremeMult = input.float(2.5, title="Extreme Regime Threshold (x median)", minval=1.0, step=0.1)

// --- Volume Anomaly ---
int    volAnomalyWindow = input.int(60, title="Volume Anomaly Lookback", minval=10)
float  volAnomalyZ      = input.float(3.0, title="Volume Z-Score Threshold", minval=1.0, step=0.5)

// --- OBV Divergence ---
int    obvDivLookback   = input.int(14, title="OBV Divergence Lookback", minval=5)

// --- Volatility Clustering ---
float  clusterThreshold = input.float(2.0, title="Cluster Threshold (x avg |return|)", minval=1.0, step=0.25)
int    clusterCount     = input.int(2, title="Min Consecutive Large Moves", minval=1)

// --- Risk Management ---
int    atrLen           = input.int(14, title="ATR Length", minval=1)
int    rsiLen           = input.int(14, title="RSI Length", minval=2)
float  stopMult         = input.float(2.0, title="ATR Stop Multiplier", minval=0.5, step=0.25)

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────

float rsiVal = ta.rsi(close, rsiLen)
plot(rsiVal, title="RSI", color=color.new(color.gray, 100), display=display.data_window)
float atrVal = ta.atr(atrLen)
plot(atrVal, title="ATR", color=color.new(color.gray, 100), display=display.data_window)
float obvRaw = ta.obv

// ─────────────────────────────────────────────────────────────────────────────
// EXTRA COMPUTATIONS
// ─────────────────────────────────────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════
// ROLLING REALIZED VOLATILITY
// ═══════════════════════════════════════════════════════════════

// Daily log returns
float logRet = math.log(close / close[1])

// Rolling realized vol (annualized)
float realizedVol = ta.stdev(logRet, volWindow) * math.sqrt(volAnnFactor)

// Historical median vol approximation (200-bar percentile)
float medianVol = ta.percentile_nearest_rank(realizedVol, 200, 50)

// ═══════════════════════════════════════════════════════════════
// VOLATILITY REGIME CLASSIFICATION
// 0 = Low, 1 = Normal, 2 = High, 3 = Extreme
// ═══════════════════════════════════════════════════════════════

float highThreshold = medianVol * regimeHighMult
float extremeThreshold = medianVol * regimeExtremeMult
float lowThreshold = medianVol * 0.5

int regime = realizedVol >= extremeThreshold ? 3 : realizedVol >= highThreshold ? 2 : realizedVol <= lowThreshold ? 0 : 1

// Regime transitions
bool regimeUp = regime > regime[1] and regime[1] != 0
bool regimeDown = regime < regime[1] and regime[1] != 0

// ═══════════════════════════════════════════════════════════════
// VOLUME ANOMALY DETECTION (Z-Score)
// ═══════════════════════════════════════════════════════════════

float volMean = ta.sma(volume, volAnomalyWindow)
float volStd = ta.stdev(volume, volAnomalyWindow)
float volZScore = volStd > 0 ? (volume - volMean) / volStd : 0
bool volAnomaly = volZScore > volAnomalyZ

// ═══════════════════════════════════════════════════════════════
// OBV DIVERGENCE DETECTION
// ═══════════════════════════════════════════════════════════════

// Smoothed OBV for trend
float obvSmooth = ta.ema(obvRaw, 5)
float obvTrend = obvSmooth - obvSmooth[1]

// Price making new high but OBV not confirming = bearish divergence
float priceHigh = ta.highest(high, obvDivLookback)
float obvHigh = ta.highest(obvRaw, obvDivLookback)
bool obvBearDiv = high >= priceHigh and obvRaw < obvHigh * 0.95

// Price making new low but OBV not confirming = bullish divergence
float priceLow = ta.lowest(low, obvDivLookback)
float obvLow = ta.lowest(obvRaw, obvDivLookback)
bool obvBullDiv = low <= priceLow and obvRaw > obvLow * 1.05

// ═══════════════════════════════════════════════════════════════
// VOLATILITY CLUSTERING
// Big moves follow big moves (ACF = 0.45)
// ═══════════════════════════════════════════════════════════════

float absRet = math.abs(logRet)
float avgAbsRet = ta.sma(absRet, 20)
bool largeMove = absRet > avgAbsRet * clusterThreshold

// Count consecutive large moves
var int clusterLen = 0
if largeMove
    clusterLen += 1
else
    clusterLen := 0

bool clusterActive = clusterLen >= clusterCount

// ═══════════════════════════════════════════════════════════════
// DYNAMIC STOP LEVELS (ATR-scaled by regime)
// ═══════════════════════════════════════════════════════════════

// Wider stops in high-vol regimes (GME has Student-t df=1.95)
float regimeStopScale = regime == 3 ? 3.0 : regime == 2 ? 2.0 : regime == 0 ? 1.0 : 1.5
float dynamicStop = atrVal * stopMult * regimeStopScale

// Stop price levels
float longStopPrice = close - dynamicStop
float shortStopPrice = close + dynamicStop

// ─────────────────────────────────────────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────────────────────────────────────────

bool isMarket = session.ismarket
bool isNewDay = timeframe.change("D")
int  barOfDay = ta.barssince(isNewDay) + 1

// ─────────────────────────────────────────────────────────────────────────────
// POSITION SIZING
// ─────────────────────────────────────────────────────────────────────────────

f_qty(float entry, float stop) =>
    float cap    = 100000.0
    float risk   = cap * (1.0 / 100.0)
    float perSh  = math.abs(entry - stop)
    float raw    = perSh > 0 ? risk / perSh : 1.0
    float maxQty = entry > 0 ? cap / entry * 0.95 : 1.0
    math.max(math.min(raw, maxQty), 1.0)

// ─────────────────────────────────────────────────────────────────────────────
// RISK MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

var int   dayTrades  = 0
var int   lastBarEntry = 0
var int   consecLoss = 0
var bool  tripped    = false
var float dayEquity  = 0.0
var bool  dayLimited = false

if isNewDay
    dayTrades  := 0
    lastBarEntry := 0
    consecLoss := 0
    tripped    := false
    dayEquity  := strategy.equity
    dayLimited := false

if dayEquity > 0 and (strategy.equity - dayEquity) / dayEquity * 100 <= -3.0
    dayLimited := true

bool ready  = isMarket and dayTrades < 4 and not tripped and not dayLimited
bool spaced = (bar_index - lastBarEntry) >= 3 or lastBarEntry == 0

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition  = (regime == 1 or regime == 2) and volAnomaly and obvTrend > 0 and rsiVal < 70 and (clusterActive or regimeUp)
bool shortCondition = (regime == 1 or regime == 2) and volAnomaly and obvTrend < 0 and rsiVal > 30 and (clusterActive or regimeDown)

bool exitLongCond  = strategy.position_size > 0 and (regime == 3 or obvBearDiv or rsiVal > 80)
bool exitShortCond = strategy.position_size < 0 and (regime == 3 or obvBullDiv or rsiVal < 20)

// ─────────────────────────────────────────────────────────────────────────────
// SL / TP CALCULATION
// ─────────────────────────────────────────────────────────────────────────────

float atrVal   = ta.atr(14)
float slRisk   = math.min(atrVal * 1.5, 2.0)
float longSL   = close - slRisk
float longTP   = close + slRisk * 1.5
float shortSL  = close + slRisk
float shortTP  = close - slRisk * 1.5

// ─────────────────────────────────────────────────────────────────────────────
// EXECUTION
// ─────────────────────────────────────────────────────────────────────────────

var float  pendingSL  = na
var float  pendingTP_ = na
var int    pendingDir = 0

bool goLong  = longCondition and ready and spaced and barstate.isconfirmed
bool goShort = shortCondition and ready and spaced and barstate.isconfirmed

if goLong
    if strategy.position_size < 0
        strategy.close("S", comment="Flip")
    float qty = f_qty(close, longSL)
    strategy.entry("L", strategy.long, qty=qty, comment="GME-QRP|L")
    strategy.exit("LX", "L", stop=longSL, limit=longTP)
    dayTrades    += 1
    lastBarEntry := bar_index
    pendingSL    := longSL
    pendingTP_   := longTP
    pendingDir   := 1
    alert("GME Quant Regime Prediction: LONG | E " + str.tostring(close, format.mintick) + " | SL " + str.tostring(longSL, format.mintick) + " | TP " + str.tostring(longTP, format.mintick) + " | Qty " + str.tostring(qty, "#"), alert.freq_once_per_bar_close)

if goShort
    if strategy.position_size > 0
        strategy.close("L", comment="Flip")
    float qty = f_qty(close, shortSL)
    strategy.entry("S", strategy.short, qty=qty, comment="GME-QRP|S")
    strategy.exit("SX", "S", stop=shortSL, limit=shortTP)
    dayTrades    += 1
    lastBarEntry := bar_index
    pendingSL    := shortSL
    pendingTP_   := shortTP
    pendingDir   := -1
    alert("GME Quant Regime Prediction: SHORT | E " + str.tostring(close, format.mintick) + " | SL " + str.tostring(shortSL, format.mintick) + " | TP " + str.tostring(shortTP, format.mintick) + " | Qty " + str.tostring(qty, "#"), alert.freq_once_per_bar_close)

// Condition-based exits (strategy SL/TP handled by strategy.exit)
if exitLongCond
    strategy.close("L", comment="ExitLong")
if exitShortCond
    strategy.close("S", comment="ExitShort")


// ─────────────────────────────────────────────────────────────────────────────
// TRADE LABELS
// ─────────────────────────────────────────────────────────────────────────────

bool newLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
float fillPrice = strategy.position_avg_price

if newLong and not na(pendingSL) and pendingDir == 1
    label.new(bar_index, low - atrVal * 0.5,
         "\U0001F4C8 LONG" +
         "\nGME Quant Regime Prediction" +
         "\nE  " + str.tostring(fillPrice, format.mintick) +
         "\nS  " + str.tostring(pendingSL, format.mintick) +
         "\nT  " + str.tostring(pendingTP_, format.mintick),
         style=label.style_label_up,
         color=color.new(#1B5E20, 0),
         textcolor=color.new(#FFFFFF, 0),
         size=size.small)

if newShort and not na(pendingSL) and pendingDir == -1
    label.new(bar_index, high + atrVal * 0.5,
         "\U0001F4C9 SHORT" +
         "\nGME Quant Regime Prediction" +
         "\nE  " + str.tostring(fillPrice, format.mintick) +
         "\nS  " + str.tostring(pendingSL, format.mintick) +
         "\nT  " + str.tostring(pendingTP_, format.mintick),
         style=label.style_label_down,
         color=color.new(#B71C1C, 0),
         textcolor=color.new(#FFFFFF, 0),
         size=size.small)


// ─────────────────────────────────────────────────────────────────────────────
// EXIT MANAGEMENT — BREAKEVEN + FILL ALIGNMENT
// ─────────────────────────────────────────────────────────────────────────────

var float entryPrice = na
var float origSL     = na
var float pendingTP  = na
var bool  movedBE    = false
float beBuf = 0.05

// Position open — capture fill price and realign exits
if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryPrice := strategy.position_avg_price
    movedBE    := false
    if strategy.position_size > 0
        float _slDist = slRisk
        origSL    := entryPrice - _slDist
        pendingTP := entryPrice + _slDist * 1.5
        strategy.exit("LX", "L", stop=origSL, limit=pendingTP)
    else
        float _slDist = slRisk
        origSL    := entryPrice + _slDist
        pendingTP := entryPrice - _slDist * 1.5
        strategy.exit("SX", "S", stop=origSL, limit=pendingTP)

// Breakeven trigger at 0.5R
if strategy.position_size > 0 and not movedBE and not na(entryPrice) and not na(origSL)
    float riskAmt = entryPrice - origSL
    if riskAmt > 0 and close >= entryPrice + riskAmt * 0.5
        strategy.exit("LX", "L", stop=entryPrice + beBuf, limit=pendingTP, comment="BE")
        movedBE := true
        alert("GME Quant Regime Prediction: BE LONG | SL → " + str.tostring(entryPrice + beBuf, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size < 0 and not movedBE and not na(entryPrice) and not na(origSL)
    float riskAmt = origSL - entryPrice
    if riskAmt > 0 and close <= entryPrice - riskAmt * 0.5
        strategy.exit("SX", "S", stop=entryPrice - beBuf, limit=pendingTP, comment="BE")
        movedBE := true
        alert("GME Quant Regime Prediction: BE SHORT | SL → " + str.tostring(entryPrice - beBuf, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size == 0
    movedBE := false

// ─────────────────────────────────────────────────────────────────────────────
// EOD CLOSE
// ─────────────────────────────────────────────────────────────────────────────

if not isMarket and isMarket[1] and strategy.position_size != 0
    strategy.close_all(comment="EOD")
    alert("GME Quant Regime Prediction: EOD CLOSE | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// LOSS TRACKING
// ─────────────────────────────────────────────────────────────────────────────

if strategy.position_size == 0 and strategy.position_size[1] != 0
    float pnl = strategy.netprofit - nz(strategy.netprofit[1])
    if pnl > 0
        consecLoss := 0
    else
        consecLoss += 1
        if consecLoss >= 3
            tripped := true
            alert("GME Quant Regime Prediction: CIRCUIT BREAKER | " + str.tostring(consecLoss) + " losses", alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// LEVEL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

var float plotEntry = na
var float plotSL    = na
var float plotTP    = na

if strategy.position_size != 0 and strategy.position_size[1] == 0
    plotEntry := entryPrice
    plotSL    := origSL
    plotTP    := pendingTP
if strategy.position_size == 0
    plotEntry := na
    plotSL    := na
    plotTP    := na

plot(plotEntry, title="Entry Price", color=color.white, style=plot.style_linebr, linewidth=2)
plot(plotTP, title="Take Profit", color=color.new(color.lime, 20), style=plot.style_linebr, linewidth=2)
plot(plotSL, title="Stop Loss", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=2)


// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if strategy.position_size > 0
    bgColor := color.new(color.green, 90)
else if strategy.position_size < 0
    bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")


// ─────────────────────────────────────────────────────────────────────────────
// ADDITIONAL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════
// REGIME BACKGROUND COLORING
// ═══════════════════════════════════════════════════════════════

color regimeBg = regime == 3 ? color.new(color.red, 80) : regime == 2 ? color.new(color.orange, 85) : regime == 0 ? color.new(color.green, 90) : na
bgcolor(regimeBg, title="Volatility Regime")

// ═══════════════════════════════════════════════════════════════
// VOLUME ANOMALY MARKERS
// ═══════════════════════════════════════════════════════════════

plotshape(volAnomaly, title="Volume Anomaly", style=shape.diamond, location=location.abovebar, color=color.new(color.yellow, 0), size=size.tiny)

// ═══════════════════════════════════════════════════════════════
// OBV DIVERGENCE MARKERS
// ═══════════════════════════════════════════════════════════════

plotshape(obvBearDiv, title="OBV Bear Divergence", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 20), size=size.tiny)
plotshape(obvBullDiv, title="OBV Bull Divergence", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 20), size=size.tiny)

// ═══════════════════════════════════════════════════════════════
// DYNAMIC STOP LEVELS
// ═══════════════════════════════════════════════════════════════

plot(posState == 1 ? longStopPrice : na, title="Long Stop", color=color.new(color.red, 40), style=plot.style_linebr, linewidth=1)
plot(posState == -1 ? shortStopPrice : na, title="Short Stop", color=color.new(color.green, 40), style=plot.style_linebr, linewidth=1)

// ═══════════════════════════════════════════════════════════════
// DATA WINDOW: Key metrics
// ═══════════════════════════════════════════════════════════════

plot(realizedVol * 100, title="Realized Vol %", color=color.new(color.gray, 100), display=display.data_window)
plot(regime, title="Vol Regime (0-3)", color=color.new(color.gray, 100), display=display.data_window)
plot(volZScore, title="Volume Z-Score", color=color.new(color.gray, 100), display=display.data_window)
plot(clusterLen, title="Cluster Length", color=color.new(color.gray, 100), display=display.data_window)
plot(dynamicStop, title="Dynamic Stop Width", color=color.new(color.gray, 100), display=display.data_window)
