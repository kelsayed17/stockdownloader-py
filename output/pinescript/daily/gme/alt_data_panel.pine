// ════════════════════════════════════════════════════════════════════════════════
// ▌ DARK POOL ATS% DATA (weekly FINRA, forward-filled)
// ════════════════════════════════════════════════════════════════════════════════

dp_lookup(t) =>
    float pct = na
    if t >= timestamp("2026-01-26")
        pct := 19.2
    else if t >= timestamp("2026-01-19")
        pct := 21.0
    else if t >= timestamp("2026-01-12")
        pct := 18.4
    else if t >= timestamp("2026-01-05")
        pct := 15.9
    else if t >= timestamp("2025-12-29")
        pct := 25.3
    else if t >= timestamp("2025-12-22")
        pct := 18.5
    else if t >= timestamp("2025-12-15")
        pct := 19.7
    else if t >= timestamp("2025-12-08")
        pct := 25.9
    else if t >= timestamp("2025-12-01")
        pct := 21.6
    else if t >= timestamp("2025-11-24")
        pct := 29.8
    else if t >= timestamp("2025-11-17")
        pct := 21.4
    else if t >= timestamp("2025-11-10")
        pct := 21.2
    else if t >= timestamp("2025-11-03")
        pct := 24.2
    else if t >= timestamp("2025-10-27")
        pct := 18.4
    else if t >= timestamp("2025-10-20")
        pct := 15.0
    else if t >= timestamp("2025-10-13")
        pct := 18.2
    else if t >= timestamp("2025-10-06")
        pct := 19.8
    else if t >= timestamp("2025-09-29")
        pct := 21.1
    else if t >= timestamp("2025-09-22")
        pct := 20.4
    else if t >= timestamp("2025-09-15")
        pct := 17.0
    else if t >= timestamp("2025-09-08")
        pct := 18.1
    else if t >= timestamp("2025-09-01")
        pct := 21.2
    else if t >= timestamp("2025-08-25")
        pct := 22.5
    else if t >= timestamp("2025-08-18")
        pct := 20.5
    else if t >= timestamp("2025-08-11")
        pct := 21.5
    else if t >= timestamp("2025-08-04")
        pct := 20.7
    else if t >= timestamp("2025-07-28")
        pct := 18.8
    else if t >= timestamp("2025-07-21")
        pct := 21.8
    else if t >= timestamp("2025-07-14")
        pct := 21.0
    else if t >= timestamp("2025-07-07")
        pct := 17.7
    else if t >= timestamp("2025-06-30")
        pct := 13.7
    else if t >= timestamp("2025-06-23")
        pct := 17.3
    else if t >= timestamp("2025-06-16")
        pct := 17.3
    else if t >= timestamp("2025-06-09")
        pct := 18.5
    else if t >= timestamp("2025-06-02")
        pct := 15.3
    else if t >= timestamp("2025-05-26")
        pct := 18.2
    else if t >= timestamp("2025-05-19")
        pct := 16.9
    else if t >= timestamp("2025-05-12")
        pct := 19.9
    else if t >= timestamp("2025-05-05")
        pct := 17.9
    else if t >= timestamp("2025-04-28")
        pct := 19.8
    else if t >= timestamp("2025-04-21")
        pct := 19.2
    else if t >= timestamp("2025-04-14")
