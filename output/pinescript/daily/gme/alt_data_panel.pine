// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © GME Alternative Data Panel — Moving Average Edition
// All data streams displayed as smoothed MAs with fast/slow crossovers

//@version=6
indicator("GME Alt Data MAs", shorttitle="GME-MA", format=format.volume)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ INPUTS
// ════════════════════════════════════════════════════════════════════════════════

grp_display = "Display Mode"
data_mode = input.string("All (Normalized MAs)", "Primary Display",
     options=["Short Interest MAs", "Days to Cover MAs", "Dark Pool ATS % MAs",
              "Borrow Rate MAs", "Institutional Ownership MAs",
              "All (Normalized MAs)"], group=grp_display)

grp_ma = "Moving Average Settings"
fast_len = input.int(10, "Fast MA Length", minval=2, maxval=50, group=grp_ma)
slow_len = input.int(30, "Slow MA Length", minval=5, maxval=100, group=grp_ma)
ma_type = input.string("EMA", "MA Type", options=["EMA", "SMA", "WMA", "VWMA-like"], group=grp_ma)
show_raw = input.bool(true, "Show Raw Data (dimmed)", group=grp_ma)
show_fill = input.bool(true, "Show Fast/Slow Fill", group=grp_ma)
show_crosses = input.bool(true, "Show MA Crossovers", group=grp_ma)

grp_thresh = "Threshold Lines"
show_thresholds = input.bool(true, "Show Threshold Lines", group=grp_thresh)
si_warn = input.float(50.0, "SI Warning (M shares)", step=5.0, group=grp_thresh)
si_danger = input.float(65.0, "SI Danger (M shares)", step=5.0, group=grp_thresh)
dtc_elevated = input.float(10.0, "DTC Elevated", step=1.0, group=grp_thresh)
dtc_extreme = input.float(20.0, "DTC Extreme", step=1.0, group=grp_thresh)
dp_normal = input.float(20.0, "DP Normal ATS%", step=1.0, group=grp_thresh)
dp_high = input.float(30.0, "DP High ATS%", step=1.0, group=grp_thresh)
br_moderate = input.float(10.0, "Borrow Rate Moderate %", step=1.0, group=grp_thresh)
br_high = input.float(30.0, "Borrow Rate High %", step=1.0, group=grp_thresh)
own_low = input.float(150.0, "Ownership Low (M shares)", step=10.0, group=grp_thresh)
own_high = input.float(300.0, "Ownership High (M shares)", step=10.0, group=grp_thresh)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ MA HELPER — computes selected MA type
// ════════════════════════════════════════════════════════════════════════════════

calc_ma(src, len) =>
    switch ma_type
        "EMA" => ta.ema(src, len)
        "SMA" => ta.sma(src, len)
        "WMA" => ta.wma(src, len)
        "VWMA-like" => ta.wma(src, len)   // weighted approximation

// ════════════════════════════════════════════════════════════════════════════════
// ▌ SHORT INTEREST DATA (bi-monthly FINRA reports, forward-filled)
// ════════════════════════════════════════════════════════════════════════════════

