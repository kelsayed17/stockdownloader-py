// ════════════════════════════════════════════════════════════════════════════════
// ▌ OWNERSHIP DATA (Quarterly 13F, forward-filled — SEC EDGAR post-split adjusted)
// ════════════════════════════════════════════════════════════════════════════════

own_lookup(t) =>
    // Data sourced directly from SEC EDGAR EFTS 13F-HR filings (CUSIP 36467W109)
    // All values normalized to post-split equivalent (4:1 split Jul 21 2022)
    // Pre-split quarters (through Q2 2022) multiplied by 4 for consistency
    float shares = na
    if t >= timestamp("2025-12-31")
        shares := 252217128
    else if t >= timestamp("2025-09-30")
        shares := 346318462
    else if t >= timestamp("2025-06-30")
        shares := 248056152
    else if t >= timestamp("2025-03-31")
        shares := 205780423
    else if t >= timestamp("2024-12-31")
        shares := 174076681
    else if t >= timestamp("2024-09-30")
        shares := 155176699
    else if t >= timestamp("2024-06-30")
        shares := 123415716
    else if t >= timestamp("2024-03-31")
        shares := 108170198
    else if t >= timestamp("2023-12-31")
        shares := 105591721
    else if t >= timestamp("2023-09-30")
        shares := 100772296
    else if t >= timestamp("2023-06-30")
        shares := 126726539
    else if t >= timestamp("2023-03-31")
        shares := 120928429
    else if t >= timestamp("2022-12-31")
        shares := 122620755
    else if t >= timestamp("2022-09-30")
        shares := 120355288
    // --- Pre-split quarters below: as-filed shares x4 for post-split equivalent ---
    else if t >= timestamp("2022-06-30")
        shares := 141494068    // 35,373,517 x 4
    else if t >= timestamp("2022-03-31")
        shares := 209717424    // 52,429,356 x 4
    else if t >= timestamp("2021-12-31")
        shares := 144110656    // 36,027,664 x 4
    else if t >= timestamp("2021-09-30")
        shares := 148790064    // 37,197,516 x 4
    else if t >= timestamp("2021-06-30")
        shares := 197665164    // 49,416,291 x 4
    else if t >= timestamp("2021-03-31")
        shares := 211501320    // 52,875,330 x 4
    else if t >= timestamp("2020-12-31")
        shares := 442665764    // 110,666,441 x 4
    else if t >= timestamp("2020-09-30")
        shares := 367241180    // 91,810,295 x 4
    else if t >= timestamp("2020-06-30")
        shares := 390260564    // 97,565,141 x 4
    else if t >= timestamp("2020-03-31")
        shares := 403126004    // 100,781,501 x 4
    shares

// ════════════════════════════════════════════════════════════════════════════════
// ▌ RAW DATA SERIES
// ════════════════════════════════════════════════════════════════════════════════

bar_ts = time
[raw_si, raw_dtc] = si_lookup(bar_ts)
raw_dp_pct = dp_lookup(bar_ts)
raw_own = own_lookup(bar_ts)

// Convert SI to millions
raw_si_m = not na(raw_si) ? raw_si / 1e6 : na

// Ownership in millions
raw_own_m = not na(raw_own) ? raw_own / 1e6 : na

// Borrow rate estimate from DTC
raw_borrow = if na(raw_dtc)
    na
else if raw_dtc < 1.0
    0.25 + (raw_dtc / 1.0) * 0.75
else if raw_dtc < 3.0
    1.0 + ((raw_dtc - 1.0) / 2.0) * 4.0
else if raw_dtc < 7.0
    5.0 + ((raw_dtc - 3.0) / 4.0) * 15.0
else if raw_dtc < 15.0
    20.0 + ((raw_dtc - 7.0) / 8.0) * 30.0
else
    math.min(50.0 + (raw_dtc - 15.0) * 3.0, 100.0)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ MOVING AVERAGES ON ALL DATA STREAMS
// ════════════════════════════════════════════════════════════════════════════════

// Short Interest MAs
si_fast = calc_ma(raw_si_m, fast_len)
si_slow = calc_ma(raw_si_m, slow_len)

// Days to Cover MAs
dtc_fast = calc_ma(raw_dtc, fast_len)
dtc_slow = calc_ma(raw_dtc, slow_len)

// Dark Pool ATS% MAs
dp_fast = calc_ma(raw_dp_pct, fast_len)
dp_slow = calc_ma(raw_dp_pct, slow_len)

// Borrow Rate MAs
br_fast = calc_ma(raw_borrow, fast_len)
br_slow = calc_ma(raw_borrow, slow_len)

// Ownership MAs
own_fast = calc_ma(raw_own_m, fast_len)
own_slow = calc_ma(raw_own_m, slow_len)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ CROSSOVER SIGNALS
// ════════════════════════════════════════════════════════════════════════════════

si_bull_cross  = ta.crossover(si_fast, si_slow)
si_bear_cross  = ta.crossunder(si_fast, si_slow)
dtc_bull_cross = ta.crossover(dtc_fast, dtc_slow)
dtc_bear_cross = ta.crossunder(dtc_fast, dtc_slow)
dp_bull_cross  = ta.crossover(dp_fast, dp_slow)
dp_bear_cross  = ta.crossunder(dp_fast, dp_slow)
br_bull_cross  = ta.crossover(br_fast, br_slow)
br_bear_cross  = ta.crossunder(br_fast, br_slow)
own_bull_cross = ta.crossover(own_fast, own_slow)
own_bear_cross = ta.crossunder(own_fast, own_slow)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ COLOR HELPERS
// ════════════════════════════════════════════════════════════════════════════════

col_fast  = #00bcd4  // Cyan for fast MA
col_slow  = #ff9800  // Orange for slow MA
col_raw   = color.new(color.gray, 60)
col_bull_fill = color.new(color.green, 80)
col_bear_fill = color.new(color.red, 80)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ MODE FLAGS — used for conditional visibility at global scope
// ════════════════════════════════════════════════════════════════════════════════

show_si_mode  = data_mode == "Short Interest MAs"
show_dtc_mode = data_mode == "Days to Cover MAs"
show_dp_mode  = data_mode == "Dark Pool ATS % MAs"
show_br_mode  = data_mode == "Borrow Rate MAs"
show_own_mode = data_mode == "Institutional Ownership MAs"
show_all_mode = data_mode == "All (Normalized MAs)"

// ════════════════════════════════════════════════════════════════════════════════
// ▌ NORMALIZED DATA FOR "ALL" MODE (computed at global scope)
// ════════════════════════════════════════════════════════════════════════════════

si_norm  = not na(raw_si_m)   ? math.min(raw_si_m / 80.0 * 100, 100)    : na  // 80M = ceiling
dtc_norm = not na(raw_dtc)    ? math.min(raw_dtc / 25.0 * 100, 100)     : na  // 25d = ceiling
dp_norm  = not na(raw_dp_pct) ? math.min(raw_dp_pct / 40.0 * 100, 100)  : na  // 40% = ceiling
br_norm  = not na(raw_borrow) ? math.min(raw_borrow / 80.0 * 100, 100)  : na  // 80% = ceiling
own_norm = not na(raw_own_m)  ? math.min(raw_own_m / 500.0 * 100, 100)  : na  // 500M = ceiling (split-adjusted)

// Fast MAs of normalized values
si_n_ma  = calc_ma(si_norm, fast_len)
dtc_n_ma = calc_ma(dtc_norm, fast_len)
dp_n_ma  = calc_ma(dp_norm, fast_len)
br_n_ma  = calc_ma(br_norm, fast_len)
own_n_ma = calc_ma(own_norm, fast_len)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ CONDITIONAL PLOT VALUES — na hides the plot when mode is not active
// ════════════════════════════════════════════════════════════════════════════════

// --- Short Interest mode values ---
si_raw_val  = show_si_mode and show_raw ? raw_si_m : na
si_fast_val = show_si_mode ? si_fast : na
si_slow_val = show_si_mode ? si_slow : na

// --- Days to Cover mode values ---
dtc_raw_val  = show_dtc_mode and show_raw ? raw_dtc : na
dtc_fast_val = show_dtc_mode ? dtc_fast : na
dtc_slow_val = show_dtc_mode ? dtc_slow : na
dtc_zero_val = show_dtc_mode ? 0.0 : na

// --- Dark Pool mode values ---
dp_raw_val  = show_dp_mode and show_raw ? raw_dp_pct : na
dp_fast_val = show_dp_mode ? dp_fast : na
dp_slow_val = show_dp_mode ? dp_slow : na

// --- Borrow Rate mode values ---
br_raw_val  = show_br_mode and show_raw ? raw_borrow : na
br_fast_val = show_br_mode ? br_fast : na
br_slow_val = show_br_mode ? br_slow : na
br_zero_val = show_br_mode ? 0.0 : na

// --- Ownership mode values ---
own_raw_val  = show_own_mode and show_raw ? raw_own_m : na
own_fast_val = show_own_mode ? own_fast : na
own_slow_val = show_own_mode ? own_slow : na

// --- All Normalized mode values ---
all_si_val  = show_all_mode ? si_n_ma : na
all_dtc_val = show_all_mode ? dtc_n_ma : na
all_dp_val  = show_all_mode ? dp_n_ma : na
all_br_val  = show_all_mode ? br_n_ma : na
all_own_val = show_all_mode ? own_n_ma : na

// ════════════════════════════════════════════════════════════════════════════════
// ▌ FILL COLORS — computed at global scope
// ════════════════════════════════════════════════════════════════════════════════

si_fill_col  = show_si_mode and show_fill ? (si_fast > si_slow ? col_bear_fill : col_bull_fill) : na
dtc_fill_col = show_dtc_mode and show_fill ? (dtc_fast > dtc_slow ? col_bear_fill : col_bull_fill) : na
dtc_zone_col = show_dtc_mode ? color.new(dtc_fast > dtc_extreme ? color.red : dtc_fast > dtc_elevated ? color.orange : color.green, 88) : na
dp_fill_col  = show_dp_mode and show_fill ? (dp_fast > dp_slow ? col_bear_fill : col_bull_fill) : na
br_fill_col  = show_br_mode and show_fill ? (br_fast > br_slow ? col_bear_fill : col_bull_fill) : na
br_zone_col  = show_br_mode ? color.new(br_fast > br_high ? color.red : br_fast > br_moderate ? color.orange : color.green, 88) : na
own_fill_col = show_own_mode and show_fill ? (own_fast > own_slow ? col_bull_fill : col_bear_fill) : na

// ════════════════════════════════════════════════════════════════════════════════
// ▌ PLOTS — ALL at global scope, hidden via na when mode is inactive
// ════════════════════════════════════════════════════════════════════════════════

// --- Short Interest MAs ---
p_si_raw  = plot(si_raw_val,  "SI Raw",     color=col_raw,  linewidth=1, style=plot.style_stepline)
p_si_fast = plot(si_fast_val, "SI Fast MA", color=col_fast, linewidth=2)
p_si_slow = plot(si_slow_val, "SI Slow MA", color=col_slow, linewidth=2)
fill(p_si_fast, p_si_slow, color=si_fill_col)

// --- Days to Cover MAs ---
p_dtc_raw  = plot(dtc_raw_val,  "DTC Raw",     color=col_raw,  linewidth=1, style=plot.style_stepline)
p_dtc_fast = plot(dtc_fast_val, "DTC Fast MA", color=col_fast, linewidth=2)
p_dtc_slow = plot(dtc_slow_val, "DTC Slow MA", color=col_slow, linewidth=2)
p_dtc_zero = plot(dtc_zero_val, "DTC Zero",    display=display.none)
fill(p_dtc_fast, p_dtc_slow, color=dtc_fill_col)
fill(p_dtc_fast, p_dtc_zero, color=dtc_zone_col)

// --- Dark Pool ATS% MAs ---
p_dp_raw  = plot(dp_raw_val,  "DP Raw",     color=col_raw,  linewidth=1, style=plot.style_stepline)
p_dp_fast = plot(dp_fast_val, "DP Fast MA", color=col_fast, linewidth=2)
p_dp_slow = plot(dp_slow_val, "DP Slow MA", color=col_slow, linewidth=2)
fill(p_dp_fast, p_dp_slow, color=dp_fill_col)

// --- Borrow Rate MAs ---
p_br_raw  = plot(br_raw_val,  "BR Raw",     color=col_raw,  linewidth=1, style=plot.style_stepline)
p_br_fast = plot(br_fast_val, "BR Fast MA", color=col_fast, linewidth=2)
p_br_slow = plot(br_slow_val, "BR Slow MA", color=col_slow, linewidth=2)
p_br_zero = plot(br_zero_val, "BR Zero",    display=display.none)
fill(p_br_fast, p_br_slow, color=br_fill_col)
fill(p_br_fast, p_br_zero, color=br_zone_col)

// --- Ownership MAs ---
p_own_raw  = plot(own_raw_val,  "Own Raw",     color=col_raw,  linewidth=1, style=plot.style_stepline)
p_own_fast = plot(own_fast_val, "Own Fast MA", color=col_fast, linewidth=2)
p_own_slow = plot(own_slow_val, "Own Slow MA", color=col_slow, linewidth=2)
fill(p_own_fast, p_own_slow, color=own_fill_col)

// --- All Normalized MAs ---
plot(all_si_val,  "SI MA (Norm)",        color=color.new(color.orange, 10), linewidth=2)
plot(all_dtc_val, "DTC MA (Norm)",       color=color.new(color.red, 10),    linewidth=2)
plot(all_dp_val,  "Dark Pool MA (Norm)", color=color.new(color.purple, 10), linewidth=2)
plot(all_br_val,  "Borrow MA (Norm)",    color=color.new(color.yellow, 10), linewidth=2)
plot(all_own_val, "Ownership MA (Norm)", color=color.new(color.green, 10),  linewidth=2)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ THRESHOLD LINES — plot() with constant values instead of hline()
// ▌ Using plot() so we can conditionally hide via na
// ════════════════════════════════════════════════════════════════════════════════

// Short Interest thresholds
plot(show_si_mode and show_thresholds ? si_warn : na,   "SI Warning",  color=color.new(color.orange, 50), linewidth=1, style=plot.style_cross)
plot(show_si_mode and show_thresholds ? si_danger : na, "SI Danger",   color=color.new(color.red, 50),    linewidth=1, style=plot.style_cross)

// Days to Cover thresholds
plot(show_dtc_mode and show_thresholds ? dtc_elevated : na, "DTC Elevated", color=color.new(color.orange, 50), linewidth=1, style=plot.style_cross)
plot(show_dtc_mode and show_thresholds ? dtc_extreme : na,  "DTC Extreme",  color=color.new(color.red, 50),    linewidth=1, style=plot.style_cross)

// Dark Pool thresholds
plot(show_dp_mode and show_thresholds ? dp_normal : na, "DP Normal", color=color.new(color.orange, 50), linewidth=1, style=plot.style_cross)
plot(show_dp_mode and show_thresholds ? dp_high : na,   "DP High",   color=color.new(color.red, 50),    linewidth=1, style=plot.style_cross)

// Borrow Rate thresholds
plot(show_br_mode and show_thresholds ? br_moderate : na, "BR Moderate", color=color.new(color.orange, 50), linewidth=1, style=plot.style_cross)
plot(show_br_mode and show_thresholds ? br_high : na,     "BR High",     color=color.new(color.red, 50),    linewidth=1, style=plot.style_cross)

// Ownership thresholds
plot(show_own_mode and show_thresholds ? own_low : na,  "Own Low",  color=color.new(color.red, 50),   linewidth=1, style=plot.style_cross)
plot(show_own_mode and show_thresholds ? own_high : na, "Own High", color=color.new(color.green, 50), linewidth=1, style=plot.style_cross)

// All Normalized mode reference lines
plot(show_all_mode ? 50.0 : na, "Midpoint",  color=color.new(color.gray, 60),  linewidth=1, style=plot.style_cross)
plot(show_all_mode ? 75.0 : na, "High Zone", color=color.new(color.red, 70),   linewidth=1, style=plot.style_cross)
plot(show_all_mode ? 25.0 : na, "Low Zone",  color=color.new(color.green, 70), linewidth=1, style=plot.style_cross)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ CROSSOVER SHAPES — ALL at global scope, hidden via false condition
// ════════════════════════════════════════════════════════════════════════════════

// SI crossovers (SI rising = bearish for stock, so up-triangle = red)
plotshape(show_si_mode and show_crosses and si_bull_cross ? true : false, "SI Rising",  shape.triangleup,   location.bottom, color.red,   size=size.tiny)
plotshape(show_si_mode and show_crosses and si_bear_cross ? true : false, "SI Falling", shape.triangledown, location.top,    color.green, size=size.tiny)

// DTC crossovers
plotshape(show_dtc_mode and show_crosses and dtc_bull_cross ? true : false, "DTC Rising",  shape.triangleup,   location.bottom, color.red,   size=size.tiny)
plotshape(show_dtc_mode and show_crosses and dtc_bear_cross ? true : false, "DTC Falling", shape.triangledown, location.top,    color.green, size=size.tiny)

// DP crossovers
plotshape(show_dp_mode and show_crosses and dp_bull_cross ? true : false, "DP Rising",  shape.triangleup,   location.bottom, color.orange, size=size.tiny)
plotshape(show_dp_mode and show_crosses and dp_bear_cross ? true : false, "DP Falling", shape.triangledown, location.top,    color.green,  size=size.tiny)

// BR crossovers
plotshape(show_br_mode and show_crosses and br_bull_cross ? true : false, "BR Rising",  shape.triangleup,   location.bottom, color.red,   size=size.tiny)
plotshape(show_br_mode and show_crosses and br_bear_cross ? true : false, "BR Falling", shape.triangledown, location.top,    color.green, size=size.tiny)

// Ownership crossovers (rising ownership = bullish, so up-triangle = green)
plotshape(show_own_mode and show_crosses and own_bull_cross ? true : false, "Own Rising",  shape.triangleup,   location.bottom, color.green, size=size.tiny)
plotshape(show_own_mode and show_crosses and own_bear_cross ? true : false, "Own Falling", shape.triangledown, location.top,    color.red,   size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ DATA CHANGE MARKERS
// ════════════════════════════════════════════════════════════════════════════════

si_changed = not na(raw_si) and (na(raw_si[1]) or raw_si != raw_si[1])
dp_changed = not na(raw_dp_pct) and (na(raw_dp_pct[1]) or raw_dp_pct != raw_dp_pct[1])
own_changed = not na(raw_own) and (na(raw_own[1]) or raw_own != raw_own[1])

bgcolor(si_changed ? color.new(color.orange, 88) : na, title="SI Report Day")
bgcolor(dp_changed ? color.new(color.purple, 92) : na, title="DP Report Day")
bgcolor(own_changed ? color.new(color.teal, 92) : na, title="13F Report Day")

// ════════════════════════════════════════════════════════════════════════════════
// ▌ LEGEND TABLE (table calls are fine in local scope)
// ════════════════════════════════════════════════════════════════════════════════

if barstate.islast and show_all_mode
    var tbl = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.gray)
    table.cell(tbl, 0, 0, "LEGEND", text_color=color.white, bgcolor=color.new(color.blue, 30), text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(tbl, 0, 0, 1, 0)
    table.cell(tbl, 0, 1, "━━", text_color=color.orange, text_size=size.tiny)
    table.cell(tbl, 1, 1, "Short Interest", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 2, "━━", text_color=color.red, text_size=size.tiny)
    table.cell(tbl, 1, 2, "Days to Cover", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 3, "━━", text_color=color.purple, text_size=size.tiny)
    table.cell(tbl, 1, 3, "Dark Pool ATS%", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 4, "━━", text_color=color.yellow, text_size=size.tiny)
    table.cell(tbl, 1, 4, "Borrow Rate Est", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 5, "━━", text_color=color.green, text_size=size.tiny)
    table.cell(tbl, 1, 5, "Inst. Ownership", text_color=color.white, text_size=size.tiny)
    table.cell(tbl, 0, 6, "Scale", text_color=color.gray, text_size=size.tiny)
    table.cell(tbl, 1, 6, "0-100 normalized", text_color=color.gray, text_size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ ALERTS
// ════════════════════════════════════════════════════════════════════════════════

alertcondition(show_crosses and si_bull_cross, title="SI Fast > Slow (Bearish)", message="GME Short Interest fast MA crossed above slow — shorts increasing")
alertcondition(show_crosses and si_bear_cross, title="SI Fast < Slow (Bullish)", message="GME Short Interest fast MA crossed below slow — shorts decreasing")
alertcondition(show_crosses and dtc_bull_cross, title="DTC Fast > Slow", message="GME Days-to-Cover trending up — squeeze pressure building")
alertcondition(show_crosses and dtc_bear_cross, title="DTC Fast < Slow", message="GME Days-to-Cover trending down — squeeze pressure easing")
alertcondition(show_crosses and own_bull_cross, title="Ownership Rising", message="GME Institutional ownership fast MA crossed above slow — accumulation")
alertcondition(show_crosses and own_bear_cross, title="Ownership Falling", message="GME Institutional ownership fast MA crossed below slow — distribution")
alertcondition(si_changed, title="New SI Report", message="New GME Short Interest report published")
alertcondition(own_changed, title="New 13F Report", message="New GME 13F institutional ownership data")
