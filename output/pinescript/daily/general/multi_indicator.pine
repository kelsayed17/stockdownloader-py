// This Pine Script(tm) v6 strategy is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// Multi-Indicator Confluence
//
// 8-indicator confluence scoring strategy.
// Scores EMA trend, SMA(200), Ichimoku, RSI, MACD,
// Stochastic, OBV, and MFI.
// Buy/Sell when score meets threshold and exceeds opposite.
//
// Entry Logic:
//   Long  - Confluence score meets buy threshold and exceeds sell score
//   Short - Confluence score meets sell threshold and exceeds buy score

//@version=6
strategy("Multi-Indicator Confluence", shorttitle="MULTI", overlay=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.cash_per_order, commission_value=1.0,
     slippage=1, process_orders_on_close=false, calc_on_every_tick=false,
     margin_long=100, margin_short=100)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

int    buyThreshold     = input.int(4, title="Buy Score Threshold", minval=1)
int    sellThreshold    = input.int(4, title="Sell Score Threshold", minval=1)

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────

float ema12 = ta.ema(close, 12)
float ema26 = ta.ema(close, 26)
float sma200 = ta.sma(close, 200)
plot(sma200, title="SMA(200)", color=color.gray, linewidth=1)
float tenkanSen = (ta.highest(high, 9) + ta.lowest(low, 9)) / 2
float kijunSen = (ta.highest(high, 26) + ta.lowest(low, 26)) / 2
float senkouA = (tenkanSen + kijunSen) / 2
float senkouB = (ta.highest(high, 52) + ta.lowest(low, 52)) / 2
bool aboveCloud = close > math.max(senkouA, senkouB)
float rsiVal = ta.rsi(close, 14)
plot(rsiVal, title="RSI", color=color.new(color.gray, 100), display=display.data_window)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
float stochK = ta.stoch(close, high, low, 14)
float stochD = ta.sma(stochK, 3)
float obvVal = ta.obv
float mfiVal = ta.mfi(hlc3, 14)
plot(mfiVal, title="MFI", color=color.new(color.gray, 100), display=display.data_window)

// ─────────────────────────────────────────────────────────────────────────────
// EXTRA COMPUTATIONS
// ─────────────────────────────────────────────────────────────────────────────

// --- Buy/Sell confluence scoring ---
int buyScore = 0
int sellScore = 0

// Trend: EMA(12) vs EMA(26)
if ema12 > ema26
    buyScore += 1
if ema12 < ema26
    sellScore += 1

// Trend: Price vs SMA(200)
if sma200 > 0 and close > sma200
    buyScore += 1
if sma200 > 0 and close < sma200
    sellScore += 1

// Trend: Ichimoku cloud
if aboveCloud
    buyScore += 1
if not aboveCloud and senkouA > 0
    sellScore += 1

// Momentum: RSI crosses above 30 / below 70
if rsiVal > 30 and rsiVal[1] <= 30
    buyScore += 1
if rsiVal < 70 and rsiVal[1] >= 70
    sellScore += 1

// Momentum: MACD crossover
if macdLine > macdSignal and macdLine[1] <= macdSignal[1]
    buyScore += 1
if macdLine < macdSignal and macdLine[1] >= macdSignal[1]
    sellScore += 1

// Momentum: Stochastic from oversold/overbought
if stochK < 30 and stochK > stochD and stochK[1] <= stochD[1]
    buyScore += 1
if stochK > 70 and stochK < stochD and stochK[1] >= stochD[1]
    sellScore += 1

// Volume: OBV rising/falling
float obvEma = ta.ema(obvVal, 5)
if obvEma > obvEma[1]
    buyScore += 1
if obvEma <= obvEma[1]
    sellScore += 1

// Volume: MFI oversold recovery / overbought reversal
if mfiVal < 30 and mfiVal > mfiVal[1]
    buyScore += 1
if mfiVal > 70 and mfiVal < mfiVal[1]
    sellScore += 1

// ─────────────────────────────────────────────────────────────────────────────
// SESSION
// ─────────────────────────────────────────────────────────────────────────────

bool isMarket = session.ismarket
bool isNewDay = timeframe.change("D")
int  barOfDay = ta.barssince(isNewDay) + 1

// ─────────────────────────────────────────────────────────────────────────────
// POSITION SIZING
// ─────────────────────────────────────────────────────────────────────────────

f_qty(float entry, float stop) =>
    float cap    = 100000.0
    float risk   = cap * (1.0 / 100.0)
    float perSh  = math.abs(entry - stop)
    float raw    = perSh > 0 ? risk / perSh : 1.0
    float maxQty = entry > 0 ? cap / entry * 0.95 : 1.0
    math.max(math.min(raw, maxQty), 1.0)

// ─────────────────────────────────────────────────────────────────────────────
// RISK MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

var int   dayTrades  = 0
var int   lastBarEntry = 0
var int   consecLoss = 0
var bool  tripped    = false
var float dayEquity  = 0.0
var bool  dayLimited = false

if isNewDay
    dayTrades  := 0
    lastBarEntry := 0
    consecLoss := 0
    tripped    := false
    dayEquity  := strategy.equity
    dayLimited := false

if dayEquity > 0 and (strategy.equity - dayEquity) / dayEquity * 100 <= -3.0
    dayLimited := true

bool ready  = isMarket and dayTrades < 4 and not tripped and not dayLimited
bool spaced = (bar_index - lastBarEntry) >= 3 or lastBarEntry == 0

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition  = buyScore >= buyThreshold and buyScore > sellScore
bool shortCondition = sellScore >= sellThreshold and sellScore > buyScore

bool exitLongCond  = strategy.position_size > 0 and (shortCondition)
bool exitShortCond = strategy.position_size < 0 and (longCondition)

// ─────────────────────────────────────────────────────────────────────────────
// SL / TP CALCULATION
// ─────────────────────────────────────────────────────────────────────────────

float atrVal   = ta.atr(14)
float slRisk   = math.min(atrVal * 1.5, 2.0)
float longSL   = close - slRisk
float longTP   = close + slRisk * 1.5
float shortSL  = close + slRisk
float shortTP  = close - slRisk * 1.5

// ─────────────────────────────────────────────────────────────────────────────
// EXECUTION
// ─────────────────────────────────────────────────────────────────────────────

var float  pendingSL  = na
var float  pendingTP_ = na
var int    pendingDir = 0

bool goLong  = longCondition and ready and spaced and barstate.isconfirmed
bool goShort = shortCondition and ready and spaced and barstate.isconfirmed

if goLong
    if strategy.position_size < 0
        strategy.close("S", comment="Flip")
    float qty = f_qty(close, longSL)
    strategy.entry("L", strategy.long, qty=qty, comment="MULTI|L")
    strategy.exit("LX", "L", stop=longSL, limit=longTP)
    dayTrades    += 1
    lastBarEntry := bar_index
    pendingSL    := longSL
    pendingTP_   := longTP
    pendingDir   := 1
    alert("Multi-Indicator Confluence: LONG | E " + str.tostring(close, format.mintick) + " | SL " + str.tostring(longSL, format.mintick) + " | TP " + str.tostring(longTP, format.mintick) + " | Qty " + str.tostring(qty, "#"), alert.freq_once_per_bar_close)

if goShort
    if strategy.position_size > 0
        strategy.close("L", comment="Flip")
    float qty = f_qty(close, shortSL)
    strategy.entry("S", strategy.short, qty=qty, comment="MULTI|S")
    strategy.exit("SX", "S", stop=shortSL, limit=shortTP)
    dayTrades    += 1
    lastBarEntry := bar_index
    pendingSL    := shortSL
    pendingTP_   := shortTP
    pendingDir   := -1
    alert("Multi-Indicator Confluence: SHORT | E " + str.tostring(close, format.mintick) + " | SL " + str.tostring(shortSL, format.mintick) + " | TP " + str.tostring(shortTP, format.mintick) + " | Qty " + str.tostring(qty, "#"), alert.freq_once_per_bar_close)

// Condition-based exits (strategy SL/TP handled by strategy.exit)
if exitLongCond
    strategy.close("L", comment="ExitLong")
if exitShortCond
    strategy.close("S", comment="ExitShort")


// ─────────────────────────────────────────────────────────────────────────────
// TRADE LABELS
// ─────────────────────────────────────────────────────────────────────────────

bool newLong  = strategy.position_size > 0 and strategy.position_size[1] <= 0
bool newShort = strategy.position_size < 0 and strategy.position_size[1] >= 0
float fillPrice = strategy.position_avg_price

if newLong and not na(pendingSL) and pendingDir == 1
    label.new(bar_index, low - atrVal * 0.5,
         "\U0001F4C8 LONG" +
         "\nMulti-Indicator Confluence" +
         "\nE  " + str.tostring(fillPrice, format.mintick) +
         "\nS  " + str.tostring(pendingSL, format.mintick) +
         "\nT  " + str.tostring(pendingTP_, format.mintick),
         style=label.style_label_up,
         color=color.new(#1B5E20, 0),
         textcolor=color.new(#FFFFFF, 0),
         size=size.small)

if newShort and not na(pendingSL) and pendingDir == -1
    label.new(bar_index, high + atrVal * 0.5,
         "\U0001F4C9 SHORT" +
         "\nMulti-Indicator Confluence" +
         "\nE  " + str.tostring(fillPrice, format.mintick) +
         "\nS  " + str.tostring(pendingSL, format.mintick) +
         "\nT  " + str.tostring(pendingTP_, format.mintick),
         style=label.style_label_down,
         color=color.new(#B71C1C, 0),
         textcolor=color.new(#FFFFFF, 0),
         size=size.small)


// ─────────────────────────────────────────────────────────────────────────────
// EXIT MANAGEMENT — BREAKEVEN + FILL ALIGNMENT
// ─────────────────────────────────────────────────────────────────────────────

var float entryPrice = na
var float origSL     = na
var float pendingTP  = na
var bool  movedBE    = false
float beBuf = 0.05

// Position open — capture fill price and realign exits
if strategy.position_size != 0 and strategy.position_size[1] == 0
    entryPrice := strategy.position_avg_price
    movedBE    := false
    if strategy.position_size > 0
        float _slDist = slRisk
        origSL    := entryPrice - _slDist
        pendingTP := entryPrice + _slDist * 1.5
        strategy.exit("LX", "L", stop=origSL, limit=pendingTP)
    else
        float _slDist = slRisk
        origSL    := entryPrice + _slDist
        pendingTP := entryPrice - _slDist * 1.5
        strategy.exit("SX", "S", stop=origSL, limit=pendingTP)

// Breakeven trigger at 0.5R
if strategy.position_size > 0 and not movedBE and not na(entryPrice) and not na(origSL)
    float riskAmt = entryPrice - origSL
    if riskAmt > 0 and close >= entryPrice + riskAmt * 0.5
        strategy.exit("LX", "L", stop=entryPrice + beBuf, limit=pendingTP, comment="BE")
        movedBE := true
        alert("Multi-Indicator Confluence: BE LONG | SL → " + str.tostring(entryPrice + beBuf, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size < 0 and not movedBE and not na(entryPrice) and not na(origSL)
    float riskAmt = origSL - entryPrice
    if riskAmt > 0 and close <= entryPrice - riskAmt * 0.5
        strategy.exit("SX", "S", stop=entryPrice - beBuf, limit=pendingTP, comment="BE")
        movedBE := true
        alert("Multi-Indicator Confluence: BE SHORT | SL → " + str.tostring(entryPrice - beBuf, format.mintick), alert.freq_once_per_bar_close)

if strategy.position_size == 0
    movedBE := false

// ─────────────────────────────────────────────────────────────────────────────
// EOD CLOSE
// ─────────────────────────────────────────────────────────────────────────────

if not isMarket and isMarket[1] and strategy.position_size != 0
    strategy.close_all(comment="EOD")
    alert("Multi-Indicator Confluence: EOD CLOSE | " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// LOSS TRACKING
// ─────────────────────────────────────────────────────────────────────────────

if strategy.position_size == 0 and strategy.position_size[1] != 0
    float pnl = strategy.netprofit - nz(strategy.netprofit[1])
    if pnl > 0
        consecLoss := 0
    else
        consecLoss += 1
        if consecLoss >= 3
            tripped := true
            alert("Multi-Indicator Confluence: CIRCUIT BREAKER | " + str.tostring(consecLoss) + " losses", alert.freq_once_per_bar_close)

// ─────────────────────────────────────────────────────────────────────────────
// LEVEL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

var float plotEntry = na
var float plotSL    = na
var float plotTP    = na

if strategy.position_size != 0 and strategy.position_size[1] == 0
    plotEntry := entryPrice
    plotSL    := origSL
    plotTP    := pendingTP
if strategy.position_size == 0
    plotEntry := na
    plotSL    := na
    plotTP    := na

plot(plotEntry, title="Entry Price", color=color.white, style=plot.style_linebr, linewidth=2)
plot(plotTP, title="Take Profit", color=color.new(color.lime, 20), style=plot.style_linebr, linewidth=2)
plot(plotSL, title="Stop Loss", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=2)


// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if strategy.position_size > 0
    bgColor := color.new(color.green, 90)
else if strategy.position_size < 0
    bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")

