// This Pine Script(tm) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// RSI Strategy Signals
//
// Generates buy signals when RSI crosses above oversold,
// sell signals when RSI crosses below overbought.
//
// Entry Logic:
//   Long  - RSI crosses above oversold threshold
//   Short - RSI crosses below overbought threshold

//@version=6
indicator("RSI Strategy Signals", shorttitle="RSI", overlay=true, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

int    rsiPeriod        = input.int(14, title="RSI Period", minval=1)
float  oversold         = input.float(30.0, title="Oversold Threshold", minval=0.0, step=1.0)
float  overbought       = input.float(70.0, title="Overbought Threshold", minval=0.0, step=1.0)

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────

float rsiValue = ta.rsi(close, rsiPeriod)
plot(rsiValue, title="RSI", color=color.new(color.gray, 100), display=display.data_window)

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition = ta.crossover(rsiValue, oversold)
bool shortCondition = ta.crossunder(rsiValue, overbought)

// Position state: +1 = long, -1 = short, 0 = flat
var int posState = 0

bool buySignal      = longCondition and posState != 1
bool sellSignal     = shortCondition and posState != -1
bool exitLongSignal  = posState == 1 and (ta.crossunder(rsiValue, overbought))
bool exitShortSignal = posState == -1 and (ta.crossover(rsiValue, oversold))

// Update position state
if buySignal
    posState := 1
else if sellSignal
    posState := -1
else if exitLongSignal or exitShortSignal
    posState := 0

// ─────────────────────────────────────────────────────────────────────────────
// LABELS
// ─────────────────────────────────────────────────────────────────────────────

if true
    if buySignal
        label.new(bar_index, low, "Buy",
             style=label.style_label_up,
             color=color.green,
             textcolor=color.white,
             size=size.small)
    if sellSignal
        label.new(bar_index, high, "Sell",
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.small)
    if exitLongSignal
        label.new(bar_index, high, "Exit Long",
             style=label.style_label_down,
             color=color.orange,
             textcolor=color.white,
             size=size.small)
    if exitShortSignal
        label.new(bar_index, low, "Exit Short",
             style=label.style_label_up,
             color=color.orange,
             textcolor=color.white,
             size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if true
    if posState == 1
        bgColor := color.new(color.green, 90)
    else if posState == -1
        bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────

alertcondition(buySignal,
     title="Buy",
     message="RSI Strategy Signals: Buy signal triggered.")
alertcondition(sellSignal,
     title="Sell",
     message="RSI Strategy Signals: Sell signal triggered.")
alertcondition(exitLongSignal,
     title="Exit Long",
     message="RSI Strategy Signals: Exit Long signal.")
alertcondition(exitShortSignal,
     title="Exit Short",
     message="RSI Strategy Signals: Exit Short signal.")
alertcondition((buySignal or sellSignal or exitLongSignal or exitShortSignal),
     title="Any Signal",
     message="RSI Strategy Signals: Signal triggered. Check chart.")

// ─────────────────────────────────────────────────────────────────────────────
// ADDITIONAL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

plot(rsiValue, title="RSI", color=color.purple, display=display.data_window)
