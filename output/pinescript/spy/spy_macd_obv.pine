// This Pine Script(tm) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// SPY MACD+OBV (Tournament Winner)
//
// Grand Tournament Winner — Walk-forward validated.
// OOS Score: +74.03 | Degradation: 0.96 (near-perfect)
// 
// MACD crossover confirmed by OBV trend alignment.
// ATR-based TP/SL with configurable R:R ratio.
// SL capped at $2.00 default (institutional risk control).
//
// Entry Logic:
//   Long  - MACD bullish crossover + rising OBV confirms buying pressure
//   Short - MACD bearish crossunder + falling OBV confirms selling pressure

//@version=6
indicator("SPY MACD+OBV (Tournament Winner)", shorttitle="SPY-MACD-OBV", overlay=true, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────


// --- MACD ---
int    macdFast         = input.int(12, title="MACD Fast Length", minval=2)
int    macdSlow         = input.int(26, title="MACD Slow Length", minval=5)
int    macdSignal       = input.int(9, title="MACD Signal Length", minval=2)

// --- OBV ---
int    obvSmoothing     = input.int(5, title="OBV Smoothing Period", minval=2)

// --- Risk Management ---
int    atrLen           = input.int(14, title="ATR Length", minval=1)
float  slMult           = input.float(1.5, title="Stop Loss (x ATR)", minval=0.5, step=0.25)
float  rrRatio          = input.float(1.5, title="Reward:Risk Ratio", minval=0.5, step=0.25)
float  slCapDollars     = input.float(2.0, title="SL Cap ($, 0=off)", minval=0.0, step=0.25)

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────

[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignal)
float obvRaw = ta.obv
float obvSmoothed = ta.ema(obvRaw, obvSmoothing)
bool obvRising = obvSmoothed > obvSmoothed[1]
bool obvFalling = obvSmoothed < obvSmoothed[1]
float atrVal = ta.atr(atrLen)
plot(atrVal, title="ATR", color=color.new(color.gray, 100), display=display.data_window)

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition = ta.crossover(macdLine, macdSignal) and obvRising
bool shortCondition = ta.crossunder(macdLine, macdSignal) and obvFalling

// Position state: +1 = long, -1 = short, 0 = flat
var int posState = 0

bool buySignal      = longCondition and posState != 1
bool sellSignal     = shortCondition and posState != -1
bool exitLongSignal  = posState == 1 and (ta.crossunder(macdLine, macdSignal))
bool exitShortSignal = posState == -1 and (ta.crossover(macdLine, macdSignal))

// Update position state
if buySignal
    posState := 1
else if sellSignal
    posState := -1
else if exitLongSignal or exitShortSignal
    posState := 0

// ─────────────────────────────────────────────────────────────────────────────
// LABELS
// ─────────────────────────────────────────────────────────────────────────────

if true
    if buySignal
        label.new(bar_index, low, "Buy",
             style=label.style_label_up,
             color=color.green,
             textcolor=color.white,
             size=size.small)
    if sellSignal
        label.new(bar_index, high, "Sell",
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.small)
    if exitLongSignal
        label.new(bar_index, high, "Exit Long",
             style=label.style_label_down,
             color=color.orange,
             textcolor=color.white,
             size=size.small)
    if exitShortSignal
        label.new(bar_index, low, "Exit Short",
             style=label.style_label_up,
             color=color.orange,
             textcolor=color.white,
             size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if true
    if posState == 1
        bgColor := color.new(color.green, 90)
    else if posState == -1
        bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────

alertcondition(buySignal,
     title="Buy",
     message="SPY MACD+OBV (Tournament Winner): Buy signal triggered.")
alertcondition(sellSignal,
     title="Sell",
     message="SPY MACD+OBV (Tournament Winner): Sell signal triggered.")
alertcondition(exitLongSignal,
     title="Exit Long",
     message="SPY MACD+OBV (Tournament Winner): Exit Long signal.")
alertcondition(exitShortSignal,
     title="Exit Short",
     message="SPY MACD+OBV (Tournament Winner): Exit Short signal.")
alertcondition((buySignal or sellSignal or exitLongSignal or exitShortSignal),
     title="Any Signal",
     message="SPY MACD+OBV (Tournament Winner): Signal triggered. Check chart.")

// ─────────────────────────────────────────────────────────────────────────────
// ADDITIONAL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

// ═══════════════════════════════════════════════════════════════
// ENTRY PRICE & TP/SL LEVEL TRACKING
// ═══════════════════════════════════════════════════════════════

var float entryPrice  = na
var float stopPrice   = na
var float targetPrice = na
var float tradeRisk   = na

if buySignal
    entryPrice  := close
    // SL = ATR-based, capped if slCapDollars > 0
    float rawSL = atrVal * slMult
    tradeRisk   := slCapDollars > 0 ? math.min(rawSL, slCapDollars) : rawSL
    stopPrice   := close - tradeRisk
    targetPrice := close + tradeRisk * rrRatio

if sellSignal
    entryPrice  := close
    float rawSL = atrVal * slMult
    tradeRisk   := slCapDollars > 0 ? math.min(rawSL, slCapDollars) : rawSL
    stopPrice   := close + tradeRisk
    targetPrice := close - tradeRisk * rrRatio

// Clear levels on strategy exit
if exitLongSignal or exitShortSignal
    entryPrice  := na
    stopPrice   := na
    targetPrice := na
    tradeRisk   := na

// ═══════════════════════════════════════════════════════════════
// TP/SL HIT DETECTION
// ═══════════════════════════════════════════════════════════════

bool longTPHit  = posState == 1 and not na(targetPrice) and high >= targetPrice
bool longSLHit  = posState == 1 and not na(stopPrice) and low <= stopPrice
bool shortTPHit = posState == -1 and not na(targetPrice) and low <= targetPrice
bool shortSLHit = posState == -1 and not na(stopPrice) and high >= stopPrice

// Auto-exit on TP or SL hit
if longTPHit or longSLHit or shortTPHit or shortSLHit
    posState    := 0
    entryPrice  := na
    stopPrice   := na
    targetPrice := na
    tradeRisk   := na

// ═══════════════════════════════════════════════════════════════
// ENTRY PRICE LINE
// ═══════════════════════════════════════════════════════════════

plot(not na(entryPrice) ? entryPrice : na, title="Entry Price", color=color.white, style=plot.style_linebr, linewidth=2)

// ═══════════════════════════════════════════════════════════════
// TAKE PROFIT LINE (green)
// ═══════════════════════════════════════════════════════════════

plot(not na(targetPrice) ? targetPrice : na, title="Take Profit", color=color.new(color.lime, 20), style=plot.style_linebr, linewidth=2)

// ═══════════════════════════════════════════════════════════════
// STOP LOSS LINE (red)
// ═══════════════════════════════════════════════════════════════

plot(not na(stopPrice) ? stopPrice : na, title="Stop Loss", color=color.new(color.red, 20), style=plot.style_linebr, linewidth=2)

// ═══════════════════════════════════════════════════════════════
// TP/SL HIT MARKERS
// ═══════════════════════════════════════════════════════════════

plotshape(longTPHit, title="Long TP Hit", style=shape.flag, location=location.abovebar, color=color.lime, size=size.small, text="TP")
plotshape(longSLHit, title="Long SL Hit", style=shape.xcross, location=location.belowbar, color=color.red, size=size.small, text="SL")
plotshape(shortTPHit, title="Short TP Hit", style=shape.flag, location=location.belowbar, color=color.lime, size=size.small, text="TP")
plotshape(shortSLHit, title="Short SL Hit", style=shape.xcross, location=location.abovebar, color=color.red, size=size.small, text="SL")

// ═══════════════════════════════════════════════════════════════
// TP/SL ALERT CONDITIONS
// ═══════════════════════════════════════════════════════════════

alertcondition(longTPHit,
     title="Long TP Hit",
     message="SPY MACD+OBV (Tournament Winner): Long Take Profit hit!")
alertcondition(longSLHit,
     title="Long SL Hit",
     message="SPY MACD+OBV (Tournament Winner): Long Stop Loss hit!")
alertcondition(shortTPHit,
     title="Short TP Hit",
     message="SPY MACD+OBV (Tournament Winner): Short Take Profit hit!")
alertcondition(shortSLHit,
     title="Short SL Hit",
     message="SPY MACD+OBV (Tournament Winner): Short Stop Loss hit!")
alertcondition(longTPHit or longSLHit or shortTPHit or shortSLHit,
     title="Any TP/SL Hit",
     message="SPY MACD+OBV (Tournament Winner): TP or SL level hit. Check chart.")

// ═══════════════════════════════════════════════════════════════
// DATA WINDOW METRICS
// ═══════════════════════════════════════════════════════════════

plot(atrVal, title="ATR", color=color.new(color.gray, 100), display=display.data_window)
plot(not na(tradeRisk) ? tradeRisk : na, title="Trade Risk ($)", color=color.new(color.gray, 100), display=display.data_window)
plot(not na(entryPrice) and not na(targetPrice) ? math.abs(targetPrice - entryPrice) : na, title="TP Distance ($)", color=color.new(color.gray, 100), display=display.data_window)
plot(not na(entryPrice) and not na(stopPrice) ? math.abs(entryPrice - stopPrice) : na, title="SL Distance ($)", color=color.new(color.gray, 100), display=display.data_window)

// MACD histogram in data window
plot(macdHist, title="MACD Histogram", color=color.new(color.gray, 100), display=display.data_window)
