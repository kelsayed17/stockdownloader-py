// This Pine Script(tm) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// MACD Crossover Signals
//
// Generates signals on MACD / Signal line crossovers.
// Bullish when MACD crosses above Signal, bearish when below.
//
// Entry Logic:
//   Long  - MACD crosses above Signal (bullish momentum)
//   Short - MACD crosses below Signal (bearish momentum)

//@version=6
indicator("MACD Crossover Signals", shorttitle="MACD-X", overlay=true, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

int    fastLen          = input.int(12, title="MACD Fast Length", minval=1)
int    slowLen          = input.int(26, title="MACD Slow Length", minval=1)
int    signalLen        = input.int(9, title="Signal Length", minval=1)

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────

[macdLine, macdSignal, macdHist] = ta.macd(close, fastLen, slowLen, signalLen)

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition = ta.crossover(macdLine, macdSignal)
bool shortCondition = ta.crossunder(macdLine, macdSignal)

// Position state: +1 = long, -1 = short, 0 = flat
var int posState = 0

bool buySignal      = longCondition and posState != 1
bool sellSignal     = shortCondition and posState != -1
bool exitLongSignal  = posState == 1 and (shortCondition)
bool exitShortSignal = posState == -1 and (longCondition)

// Update position state
if buySignal
    posState := 1
else if sellSignal
    posState := -1
else if exitLongSignal or exitShortSignal
    posState := 0

// ─────────────────────────────────────────────────────────────────────────────
// LABELS
// ─────────────────────────────────────────────────────────────────────────────

if true
    if buySignal
        label.new(bar_index, low, "Buy",
             style=label.style_label_up,
             color=color.green,
             textcolor=color.white,
             size=size.small)
    if sellSignal
        label.new(bar_index, high, "Sell",
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.small)
    if exitLongSignal
        label.new(bar_index, high, "Exit Long",
             style=label.style_label_down,
             color=color.orange,
             textcolor=color.white,
             size=size.small)
    if exitShortSignal
        label.new(bar_index, low, "Exit Short",
             style=label.style_label_up,
             color=color.orange,
             textcolor=color.white,
             size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if true
    if posState == 1
        bgColor := color.new(color.green, 90)
    else if posState == -1
        bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────

alertcondition(buySignal,
     title="Buy",
     message="MACD Crossover Signals: Buy signal triggered.")
alertcondition(sellSignal,
     title="Sell",
     message="MACD Crossover Signals: Sell signal triggered.")
alertcondition(exitLongSignal,
     title="Exit Long",
     message="MACD Crossover Signals: Exit Long signal.")
alertcondition(exitShortSignal,
     title="Exit Short",
     message="MACD Crossover Signals: Exit Short signal.")
alertcondition((buySignal or sellSignal or exitLongSignal or exitShortSignal),
     title="Any Signal",
     message="MACD Crossover Signals: Signal triggered. Check chart.")

// ─────────────────────────────────────────────────────────────────────────────
// ADDITIONAL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

plot(macdLine, title="MACD", color=color.blue, display=display.data_window)
plot(macdSignal, title="Signal", color=color.orange, display=display.data_window)
plot(macdHist, title="Histogram", color=color.gray, display=display.data_window)
