// This Pine Script(tm) v6 indicator is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// BB + RSI Mean Reversion
//
// Mean-reversion strategy using BB touch + RSI extremes.
// ADX filter ensures we only trade in range-bound markets.
//
// Entry Logic:
//   Long  - Price at lower BB or RSI oversold recovery, in ranging market
//   Short - Price at upper BB or RSI overbought, in ranging market

//@version=6
indicator("BB + RSI Mean Reversion", shorttitle="BB-RSI", overlay=true, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────


// --- Bollinger ---
int    bbPeriod         = input.int(20, title="BB Period", minval=1)
float  bbMult           = input.float(2.0, title="BB Std Dev", minval=0.5, step=0.1)

// --- RSI ---
int    rsiPeriod        = input.int(14, title="RSI Period", minval=1)
float  rsiOS            = input.float(30.0, title="RSI Oversold", minval=0.0, step=1.0)
float  rsiOB            = input.float(70.0, title="RSI Overbought", minval=0.0, step=1.0)

// --- Filter ---
float  adxThreshold     = input.float(25.0, title="ADX Threshold", minval=0.0, step=1.0)

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────

[bbMid, bbUpper, bbLower] = ta.bb(close, bbPeriod, bbMult)
plot([bbMid, bbUpper, bbLower], title="BB", color=color.blue, linewidth=1)
float rsiValue = ta.rsi(close, rsiPeriod)
plot(rsiValue, title="RSI", color=color.new(color.gray, 100), display=display.data_window)
[plusDI, minusDI, adxValue] = ta.dmi(14, 14)
float stochK = ta.stoch(close, high, low, 14)
float stochD = ta.sma(stochK, 3)

// ─────────────────────────────────────────────────────────────────────────────
// EXTRA COMPUTATIONS
// ─────────────────────────────────────────────────────────────────────────────

// Plot BB bands
p1 = plot(bbUpper, title="BB Upper", color=color.new(color.gray, 50))
p2 = plot(bbLower, title="BB Lower", color=color.new(color.gray, 50))
fill(p1, p2, color=color.new(color.blue, 95), title="BB Fill")

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition = (close <= bbLower or ta.crossover(rsiValue, rsiOS)) and adxValue < adxThreshold and stochK < 20
bool shortCondition = (close >= bbUpper or ta.crossunder(rsiValue, rsiOB)) and adxValue < adxThreshold and stochK > 80

// Position state: +1 = long, -1 = short, 0 = flat
var int posState = 0

bool buySignal      = longCondition and posState != 1
bool sellSignal     = shortCondition and posState != -1
bool exitLongSignal  = posState == 1 and (shortCondition)
bool exitShortSignal = posState == -1 and (longCondition)

// Update position state
if buySignal
    posState := 1
else if sellSignal
    posState := -1
else if exitLongSignal or exitShortSignal
    posState := 0

// ─────────────────────────────────────────────────────────────────────────────
// LABELS
// ─────────────────────────────────────────────────────────────────────────────

if true
    if buySignal
        label.new(bar_index, low, "Buy",
             style=label.style_label_up,
             color=color.green,
             textcolor=color.white,
             size=size.small)
    if sellSignal
        label.new(bar_index, high, "Sell",
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.small)
    if exitLongSignal
        label.new(bar_index, high, "Exit Long",
             style=label.style_label_down,
             color=color.orange,
             textcolor=color.white,
             size=size.small)
    if exitShortSignal
        label.new(bar_index, low, "Exit Short",
             style=label.style_label_up,
             color=color.orange,
             textcolor=color.white,
             size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if true
    if posState == 1
        bgColor := color.new(color.green, 90)
    else if posState == -1
        bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────

alertcondition(buySignal,
     title="Buy",
     message="BB + RSI Mean Reversion: Buy signal triggered.")
alertcondition(sellSignal,
     title="Sell",
     message="BB + RSI Mean Reversion: Sell signal triggered.")
alertcondition(exitLongSignal,
     title="Exit Long",
     message="BB + RSI Mean Reversion: Exit Long signal.")
alertcondition(exitShortSignal,
     title="Exit Short",
     message="BB + RSI Mean Reversion: Exit Short signal.")
alertcondition((buySignal or sellSignal or exitLongSignal or exitShortSignal),
     title="Any Signal",
     message="BB + RSI Mean Reversion: Signal triggered. Check chart.")

// ─────────────────────────────────────────────────────────────────────────────
// ADDITIONAL PLOTS
// ─────────────────────────────────────────────────────────────────────────────

plot(rsiValue, title="RSI", color=color.purple, display=display.data_window)
plot(adxValue, title="ADX", color=color.yellow, display=display.data_window)
