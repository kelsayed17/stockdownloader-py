// https://mozilla.org/MPL/2.0/
//
// BB Squeeze Breakout
//
// Detects Bollinger Band squeeze (narrow BB width) then
// enters on breakout with volume confirmation.
//
// Entry Logic:
//   Long  - Price breaks above BB after squeeze with volume surge
//   Short - Price breaks below BB after squeeze with volume

//@version=6
indicator("BB Squeeze Breakout", shorttitle="BREAKOUT", overlay=true, max_labels_count=500)

// ─────────────────────────────────────────────────────────────────────────────
// INPUTS
// ─────────────────────────────────────────────────────────────────────────────

int    bbPeriod         = input.int(20, title="BB Period", minval=1)
int    squeezeLB        = input.int(120, title="Squeeze Lookback", minval=1)
float  volMult          = input.float(1.5, title="Volume Multiplier", minval=1.0, step=0.1)

// ─────────────────────────────────────────────────────────────────────────────
// INDICATORS
// ─────────────────────────────────────────────────────────────────────────────

[bbMid, bbUpper, bbLower] = ta.bb(close, bbPeriod, 2.0)
plot([bbMid, bbUpper, bbLower], title="BB", color=color.blue, linewidth=1)
float bbWidth = (bbUpper - bbLower) / bbMid
float minWidth = ta.lowest(bbWidth, squeezeLB)
bool isSqueeze = bbWidth <= minWidth * 1.10
float avgVol = ta.sma(volume, 20)
bool volSpike = volume > avgVol * volMult
float atrValue = ta.atr(14)
plot(atrValue, title="ATR", color=color.new(color.gray, 100), display=display.data_window)
bool atrExpanding = atrValue > atrValue[1]

// ─────────────────────────────────────────────────────────────────────────────
// EXTRA COMPUTATIONS
// ─────────────────────────────────────────────────────────────────────────────

// Plot BB bands
p1 = plot(bbUpper, title="BB Upper", color=color.new(color.gray, 50))
p2 = plot(bbLower, title="BB Lower", color=color.new(color.gray, 50))
fill(p1, p2, color=isSqueeze ? color.new(color.yellow, 85) : color.new(color.blue, 95), title="BB Fill (yellow=squeeze)")

// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL LOGIC
// ─────────────────────────────────────────────────────────────────────────────

bool longCondition = close > bbUpper and isSqueeze[1] and volSpike and atrExpanding
bool shortCondition = close < bbLower and isSqueeze[1] and volSpike

// Position state: +1 = long, -1 = short, 0 = flat
var int posState = 0

bool buySignal      = longCondition and posState != 1
bool sellSignal     = shortCondition and posState != -1
bool exitLongSignal  = posState == 1 and (close < bbMid)
bool exitShortSignal = posState == -1 and (close > bbMid)

// Update position state
if buySignal
    posState := 1
else if sellSignal
    posState := -1
else if exitLongSignal or exitShortSignal
    posState := 0

// ─────────────────────────────────────────────────────────────────────────────
// LABELS
// ─────────────────────────────────────────────────────────────────────────────

if true
    if buySignal
        label.new(bar_index, low, "Buy",
             style=label.style_label_up,
             color=color.green,
             textcolor=color.white,
             size=size.small)
    if sellSignal
        label.new(bar_index, high, "Sell",
             style=label.style_label_down,
             color=color.red,
             textcolor=color.white,
             size=size.small)
    if exitLongSignal
        label.new(bar_index, high, "Exit Long",
             style=label.style_label_down,
             color=color.orange,
             textcolor=color.white,
             size=size.small)
    if exitShortSignal
        label.new(bar_index, low, "Exit Short",
             style=label.style_label_up,
             color=color.orange,
             textcolor=color.white,
             size=size.small)

// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND
// ─────────────────────────────────────────────────────────────────────────────

color bgColor = na

if true
    if posState == 1
        bgColor := color.new(color.green, 90)
    else if posState == -1
        bgColor := color.new(color.red, 90)

bgcolor(bgColor, title="Position Zone")

// ─────────────────────────────────────────────────────────────────────────────
// ALERTS
// ─────────────────────────────────────────────────────────────────────────────

alertcondition(buySignal,
     title="Buy",
     message="BB Squeeze Breakout: Buy signal triggered.")
alertcondition(sellSignal,
     title="Sell",
     message="BB Squeeze Breakout: Sell signal triggered.")
alertcondition(exitLongSignal,
     title="Exit Long",
     message="BB Squeeze Breakout: Exit Long signal.")
alertcondition(exitShortSignal,
     title="Exit Short",
     message="BB Squeeze Breakout: Exit Short signal.")
alertcondition((buySignal or sellSignal or exitLongSignal or exitShortSignal),
     title="Any Signal",
     message="BB Squeeze Breakout: Signal triggered. Check chart.")
