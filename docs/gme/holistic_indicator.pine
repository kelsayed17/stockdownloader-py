// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © GME Holistic Analysis Indicator
// Combines FTD patterns, Short Interest, Dark Pool, Ownership & Borrow Rate data

//@version=6
indicator("GME Holistic Analysis", shorttitle="GME-HA", overlay=true, max_labels_count=500, max_lines_count=500)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ INPUT SETTINGS
// ════════════════════════════════════════════════════════════════════════════════

grp_ftd = "FTD Settings"
show_ftd = input.bool(true, "Show FTD Spike Markers", group=grp_ftd)
ftd_spike_mult = input.float(3.0, "FTD Spike Threshold (x avg)", minval=1.0, maxval=20.0, step=0.5, group=grp_ftd)
ftd_avg_period = input.int(20, "FTD Average Period", minval=5, maxval=50, group=grp_ftd)
show_t35 = input.bool(true, "Show T+35 Settlement Zones", group=grp_ftd)

grp_si = "Short Interest"
show_si = input.bool(true, "Show Short Interest Panel", group=grp_si)
si_high_dtc = input.float(10.0, "High DTC Threshold", minval=1.0, step=1.0, group=grp_si)
si_extreme_dtc = input.float(20.0, "Extreme DTC Threshold", minval=5.0, step=1.0, group=grp_si)

grp_dp = "Dark Pool"
show_dp = input.bool(true, "Show Dark Pool Panel", group=grp_dp)
dp_high_pct = input.float(25.0, "High ATS % Threshold", minval=10.0, step=1.0, group=grp_dp)

grp_vol = "Volume Analysis"
show_rvol = input.bool(true, "Show Relative Volume", group=grp_vol)
rvol_threshold = input.float(2.0, "RVOL Alert Threshold", minval=1.0, step=0.5, group=grp_vol)

grp_events = "Key Events"
show_events = input.bool(true, "Show Key Event Labels", group=grp_events)

grp_regime = "Regime Detection"
show_regime = input.bool(true, "Show Regime Background", group=grp_regime)
vol_lookback = input.int(20, "Volatility Lookback", minval=5, maxval=50, group=grp_regime)

grp_table = "Data Dashboard"
show_dashboard = input.bool(true, "Show Data Dashboard", group=grp_table)
dash_position = input.string("Top Right", "Dashboard Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=grp_table)

