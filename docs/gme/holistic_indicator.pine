// ════════════════════════════════════════════════════════════════════════════════
// ▌ OWNERSHIP DATA LOOKUP (Quarterly 13F from SEC EDGAR)
// ════════════════════════════════════════════════════════════════════════════════

own_lookup(t) =>
    float shares = na
    int inst = na

    // Data sourced directly from SEC EDGAR EFTS 13F-HR filings (CUSIP 36467W109)
    // All values normalized to post-split equivalent (4:1 split Jul 21 2022)
    // Pre-split quarters (through Q2 2022) multiplied by 4 for consistency
    if t >= timestamp("2025-12-31")
        shares := 252217128
        inst := 564
    else if t >= timestamp("2025-09-30")
        shares := 346318462
        inst := 575
    else if t >= timestamp("2025-06-30")
        shares := 248056152
        inst := 559
    else if t >= timestamp("2025-03-31")
        shares := 205780423
        inst := 569
    else if t >= timestamp("2024-12-31")
        shares := 174076681
        inst := 537
    else if t >= timestamp("2024-09-30")
        shares := 155176699
        inst := 492
    else if t >= timestamp("2024-06-30")
        shares := 123415716
        inst := 489
    else if t >= timestamp("2024-03-31")
        shares := 108170198
        inst := 456
    else if t >= timestamp("2023-12-31")
        shares := 105591721
        inst := 417
    else if t >= timestamp("2023-09-30")
        shares := 100772296
        inst := 414
    else if t >= timestamp("2023-06-30")
        shares := 126726539
        inst := 411
    else if t >= timestamp("2023-03-31")
        shares := 120928429
        inst := 389
    else if t >= timestamp("2022-12-31")
        shares := 122620755
        inst := 415
    else if t >= timestamp("2022-09-30")
        shares := 120355288
        inst := 426
    // --- Pre-split quarters below: as-filed shares x4 for post-split equivalent ---
    else if t >= timestamp("2022-06-30")
        shares := 141494068    // 35,373,517 x 4
        inst := 449
    else if t >= timestamp("2022-03-31")
        shares := 209717424    // 52,429,356 x 4
        inst := 448
    else if t >= timestamp("2021-12-31")
        shares := 144110656    // 36,027,664 x 4
        inst := 442
    else if t >= timestamp("2021-09-30")
        shares := 148790064    // 37,197,516 x 4
        inst := 452
    else if t >= timestamp("2021-06-30")
        shares := 197665164    // 49,416,291 x 4
        inst := 451
    else if t >= timestamp("2021-03-31")
        shares := 211501320    // 52,875,330 x 4
        inst := 396
    else if t >= timestamp("2020-12-31")
        shares := 442665764    // 110,666,441 x 4
        inst := 364
    else if t >= timestamp("2020-09-30")
        shares := 367241180    // 91,810,295 x 4
        inst := 331
    else if t >= timestamp("2020-06-30")
        shares := 390260564    // 97,565,141 x 4
        inst := 326
    else if t >= timestamp("2020-03-31")
        shares := 403126004    // 100,781,501 x 4
        inst := 341

    [shares, inst]

// ════════════════════════════════════════════════════════════════════════════════
// ▌ CALCULATIONS
// ════════════════════════════════════════════════════════════════════════════════

// Current bar timestamp
bar_ts = time

// Short Interest for current bar
[cur_si, cur_dtc] = si_lookup(bar_ts)

// Dark Pool for current bar
[cur_dp_total, cur_dp_ats, cur_dp_ats_pct] = dp_lookup(bar_ts)

// Ownership for current bar
[cur_own_shares, cur_own_inst] = own_lookup(bar_ts)

// Borrow rate estimate from DTC
cur_borrow = if na(cur_dtc)
    na
else if cur_dtc < 1.0
    0.25 + (cur_dtc / 1.0) * 0.75
else if cur_dtc < 3.0
    1.0 + ((cur_dtc - 1.0) / 2.0) * 4.0
else if cur_dtc < 7.0
    5.0 + ((cur_dtc - 3.0) / 4.0) * 15.0
else if cur_dtc < 15.0
    20.0 + ((cur_dtc - 7.0) / 8.0) * 30.0
else
    math.min(50.0 + (cur_dtc - 15.0) * 3.0, 100.0)

// === Moving Averages ===
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)

// === Volatility ===
daily_return = (close - close[1]) / close[1] * 100
realized_vol = ta.stdev(daily_return, vol_lookback)

// === Relative Volume ===
vol_sma = ta.sma(volume, 20)
rvol = volume / vol_sma

// === Regime Detection ===
// Bull: above SMA50, SMA50 > SMA200 (Golden Cross)
// Bear: below SMA50, SMA50 < SMA200 (Death Cross)
// Squeeze: low volatility + high SI
is_golden = sma50 > sma200
is_death = sma50 < sma200
is_above_50 = close > sma50
is_low_vol = realized_vol < ta.sma(realized_vol, 50) * 0.7
is_high_si = not na(cur_dtc) and cur_dtc > si_high_dtc
is_squeeze_setup = is_low_vol and is_high_si

// ════════════════════════════════════════════════════════════════════════════════
// ▌ REGIME BACKGROUND COLORING
// ════════════════════════════════════════════════════════════════════════════════

regime_color = if show_regime
    if is_squeeze_setup
        color.new(color.yellow, 88)
    else if is_above_50 and is_golden
        color.new(color.green, 93)
    else if not is_above_50 and is_death
        color.new(color.red, 93)
    else
        color.new(color.gray, 96)
else
    na

bgcolor(regime_color, title="Regime Background")

// ════════════════════════════════════════════════════════════════════════════════
// ▌ MOVING AVERAGES
// ════════════════════════════════════════════════════════════════════════════════

plot(sma50, "SMA 50", color=color.new(color.blue, 30), linewidth=2)
plot(sma200, "SMA 200", color=color.new(color.orange, 30), linewidth=2)

// Golden / Death Cross markers
golden_cross = ta.crossover(sma50, sma200)
death_cross = ta.crossunder(sma50, sma200)

plotshape(golden_cross, title="Golden Cross", style=shape.diamond, location=location.belowbar, color=color.green, size=size.small, text="GC")
plotshape(death_cross, title="Death Cross", style=shape.diamond, location=location.abovebar, color=color.red, size=size.small, text="DC")

// ════════════════════════════════════════════════════════════════════════════════
// ▌ RELATIVE VOLUME MARKERS
// ════════════════════════════════════════════════════════════════════════════════

is_rvol_spike = show_rvol and rvol > rvol_threshold
plotshape(is_rvol_spike, title="RVOL Spike", style=shape.triangleup, location=location.belowbar, color=color.new(color.purple, 20), size=size.tiny, text="RV")

// ════════════════════════════════════════════════════════════════════════════════
// ▌ SQUEEZE SETUP MARKERS
// ════════════════════════════════════════════════════════════════════════════════

plotshape(is_squeeze_setup and not is_squeeze_setup[1], title="Squeeze Setup", style=shape.flag, location=location.abovebar, color=color.new(color.yellow, 0), size=size.small, text="SQ")

// ════════════════════════════════════════════════════════════════════════════════
// ▌ KEY EVENT LABELS
// ════════════════════════════════════════════════════════════════════════════════

if show_events and barstate.islast
    // Key events with timestamps
    e1 = timestamp("2021-01-28")
    e2 = timestamp("2021-06-09")
    e3 = timestamp("2022-03-22")
    e4 = timestamp("2022-07-22")
    e5 = timestamp("2024-05-13")
    e6 = timestamp("2024-06-07")
    e7 = timestamp("2024-06-14")

    for i = 0 to 499
        b_ts = time[i]
        if b_ts <= e1 and time[math.max(i-1, 0)] > e1
            label.new(bar_index - i, high[i] * 1.05, "Buy Button\nRemoved", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.small)
        if b_ts <= e4 and time[math.max(i-1, 0)] > e4
            label.new(bar_index - i, high[i] * 1.05, "4:1 Split", style=label.style_label_down, color=color.blue, textcolor=color.white, size=size.small)
        if b_ts <= e5 and time[math.max(i-1, 0)] > e5
            label.new(bar_index - i, high[i] * 1.05, "DFV\nReturns", style=label.style_label_down, color=color.green, textcolor=color.white, size=size.small)
        if b_ts <= e3 and time[math.max(i-1, 0)] > e3
            label.new(bar_index - i, low[i] * 0.95, "RC Buys", style=label.style_label_up, color=color.teal, textcolor=color.white, size=size.small)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ DTC CHANGE DETECTION - Mark when new SI report drops
// ════════════════════════════════════════════════════════════════════════════════

dtc_changed = not na(cur_dtc) and (na(cur_dtc[1]) or cur_dtc != cur_dtc[1])
si_changed = not na(cur_si) and (na(cur_si[1]) or cur_si != cur_si[1])

// Mark SI report dates
plotshape(show_si and si_changed, title="SI Report", style=shape.circle, location=location.belowbar, color=color.new(color.orange, 20), size=size.tiny, text="SI")

// ════════════════════════════════════════════════════════════════════════════════
// ▌ DATA DASHBOARD TABLE
// ════════════════════════════════════════════════════════════════════════════════

if show_dashboard and barstate.islast
    pos = switch dash_position
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left

    var tbl = table.new(pos, 2, 14, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.gray, frame_width=2, frame_color=color.gray)

    // Header
    table.cell(tbl, 0, 0, "GME HOLISTIC DATA", text_color=color.white, bgcolor=color.new(color.blue, 30), text_size=size.small, text_halign=text.align_center)
    table.merge_cells(tbl, 0, 0, 1, 0)

    // Short Interest
    table.cell(tbl, 0, 1, "Short Interest", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    si_str = na(cur_si) ? "N/A" : str.tostring(cur_si / 1e6, "#.#") + "M"
    si_col = na(cur_dtc) ? color.gray : cur_dtc > si_extreme_dtc ? color.red : cur_dtc > si_high_dtc ? color.orange : color.green
    table.cell(tbl, 1, 1, si_str, text_color=si_col, text_size=size.tiny, text_halign=text.align_right)

    // Days to Cover
    table.cell(tbl, 0, 2, "Days to Cover", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    dtc_str = na(cur_dtc) ? "N/A" : str.tostring(cur_dtc, "#.##")
    table.cell(tbl, 1, 2, dtc_str, text_color=si_col, text_size=size.tiny, text_halign=text.align_right)

    // Borrow Rate
    table.cell(tbl, 0, 3, "Est. Borrow Rate", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    br_str = na(cur_borrow) ? "N/A" : str.tostring(cur_borrow, "#.#") + "%"
    br_col = na(cur_borrow) ? color.gray : cur_borrow > 30 ? color.red : cur_borrow > 10 ? color.orange : color.green
    table.cell(tbl, 1, 3, br_str, text_color=br_col, text_size=size.tiny, text_halign=text.align_right)

    // Separator
    table.cell(tbl, 0, 4, "── Dark Pool ──", text_color=color.white, bgcolor=color.new(color.purple, 60), text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(tbl, 0, 4, 1, 4)

    // ATS %
    table.cell(tbl, 0, 5, "ATS %", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    ats_str = na(cur_dp_ats_pct) ? "N/A" : str.tostring(cur_dp_ats_pct, "#.#") + "%"
    ats_col = na(cur_dp_ats_pct) ? color.gray : cur_dp_ats_pct > dp_high_pct ? color.red : color.green
    table.cell(tbl, 1, 5, ats_str, text_color=ats_col, text_size=size.tiny, text_halign=text.align_right)

    // Weekly DP Volume
    table.cell(tbl, 0, 6, "DP Weekly Vol", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    dp_vol_str = na(cur_dp_total) ? "N/A" : str.tostring(cur_dp_total / 1e6, "#.#") + "M"
    table.cell(tbl, 1, 6, dp_vol_str, text_color=color.white, text_size=size.tiny, text_halign=text.align_right)

    // Separator
    table.cell(tbl, 0, 7, "── Ownership ──", text_color=color.white, bgcolor=color.new(color.teal, 60), text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(tbl, 0, 7, 1, 7)

    // Institutional Shares
    table.cell(tbl, 0, 8, "Inst. Shares", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    own_str = na(cur_own_shares) ? "N/A" : str.tostring(cur_own_shares / 1e6, "#.##") + "M"
    table.cell(tbl, 1, 8, own_str, text_color=color.white, text_size=size.tiny, text_halign=text.align_right)

    // # Institutions
    table.cell(tbl, 0, 9, "# Institutions", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    inst_str = na(cur_own_inst) ? "N/A" : str.tostring(cur_own_inst)
    table.cell(tbl, 1, 9, inst_str, text_color=color.white, text_size=size.tiny, text_halign=text.align_right)

    // Separator
    table.cell(tbl, 0, 10, "── Technicals ──", text_color=color.white, bgcolor=color.new(color.green, 60), text_size=size.tiny, text_halign=text.align_center)
    table.merge_cells(tbl, 0, 10, 1, 10)

    // Relative Volume
    table.cell(tbl, 0, 11, "Rel. Volume", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    rvol_str = str.tostring(rvol, "#.##") + "x"
    rvol_col = rvol > rvol_threshold ? color.yellow : color.white
    table.cell(tbl, 1, 11, rvol_str, text_color=rvol_col, text_size=size.tiny, text_halign=text.align_right)

    // 20d Volatility
    table.cell(tbl, 0, 12, "20d Volatility", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    vol_str = str.tostring(realized_vol, "#.##") + "%"
    table.cell(tbl, 1, 12, vol_str, text_color=color.white, text_size=size.tiny, text_halign=text.align_right)

    // Regime
    table.cell(tbl, 0, 13, "Regime", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    regime_str = is_squeeze_setup ? "SQUEEZE SETUP" : is_above_50 and is_golden ? "BULLISH" : not is_above_50 and is_death ? "BEARISH" : "NEUTRAL"
    regime_tbl_col = is_squeeze_setup ? color.yellow : is_above_50 and is_golden ? color.green : not is_above_50 and is_death ? color.red : color.gray
    table.cell(tbl, 1, 13, regime_str, text_color=regime_tbl_col, text_size=size.tiny, text_halign=text.align_right)

// ════════════════════════════════════════════════════════════════════════════════
// ▌ ALERTS
// ════════════════════════════════════════════════════════════════════════════════

// DTC alert
alertcondition(not na(cur_dtc) and cur_dtc > si_extreme_dtc, title="Extreme DTC", message="GME Days-to-Cover is EXTREME (>20). Potential squeeze setup.")
alertcondition(not na(cur_dtc) and cur_dtc > si_high_dtc, title="High DTC", message="GME Days-to-Cover is elevated (>10).")

// RVOL alert
alertcondition(rvol > rvol_threshold, title="High RVOL", message="GME Relative Volume spike detected (>2x average).")

// Squeeze setup
alertcondition(is_squeeze_setup and not is_squeeze_setup[1], title="Squeeze Setup", message="GME Squeeze Setup: Low volatility + High short interest. Watch for breakout.")

// Golden/Death cross
alertcondition(golden_cross, title="Golden Cross", message="GME Golden Cross: SMA50 crossed above SMA200")
alertcondition(death_cross, title="Death Cross", message="GME Death Cross: SMA50 crossed below SMA200")

// High ATS%
alertcondition(not na(cur_dp_ats_pct) and cur_dp_ats_pct > dp_high_pct, title="High Dark Pool", message="GME Dark Pool ATS% elevated (>25%).")
